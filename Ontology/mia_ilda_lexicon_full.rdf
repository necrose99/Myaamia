    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.organimacy -->

    <AnnotationProperty rdf:about="http://example.organimacy"/>
    


    <!-- http://example.orgglottocode -->

    <AnnotationProperty rdf:about="http://example.orgglottocode"/>
    


    <!-- http://example.orgildaId -->

