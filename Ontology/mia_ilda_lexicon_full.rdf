     xmlns:http="http://"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org"
     xmlns:lexinfo="http://lexinfo.net"
     xmlns:ontolex="http://w3.org">
    <Ontology/>
    


