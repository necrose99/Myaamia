    <!-- http://example.orgildaLetter -->

    <AnnotationProperty rdf:about="http://example.orgildaLetter"/>
    


    <!-- http://example.orglanguageFamily -->

    <AnnotationProperty rdf:about="http://example.orglanguageFamily"/>
    


    <!-- http://example.orgspeakerRestriction -->

    <AnnotationProperty rdf:about="http://example.orgspeakerRestriction"/>
    


    <!-- http://example.orgunresolvedGloss -->

    <AnnotationProperty rdf:about="http://example.orgunresolvedGloss"/>
    


    <!-- http://lexinfo.netpartOfSpeech -->

    <AnnotationProperty rdf:about="http://lexinfo.netpartOfSpeech"/>
    


    <!-- http://purl.orgdescription -->

    <AnnotationProperty rdf:about="http://purl.orgdescription"/>
    


    <!-- http://purl.orgsource -->

    <AnnotationProperty rdf:about="http://purl.orgsource"/>
    


    <!-- http://purl.orgtitle -->

    <AnnotationProperty rdf:about="http://purl.orgtitle"/>
    


    <!-- http://w3.orgbroader -->

    <AnnotationProperty rdf:about="http://w3.orgbroader"/>
    


    <!-- http://w3.orgcanonicalForm -->

    <AnnotationProperty rdf:about="http://w3.orgcanonicalForm"/>
    


    <!-- http://w3.orgcomment -->

    <AnnotationProperty rdf:about="http://w3.orgcomment"/>
    


    <!-- http://w3.orgentry -->

    <AnnotationProperty rdf:about="http://w3.orgentry"/>
    


    <!-- http://w3.orgisDefinedBy -->

    <AnnotationProperty rdf:about="http://w3.orgisDefinedBy"/>
    


    <!-- http://w3.orgisSenseOf -->

    <AnnotationProperty rdf:about="http://w3.orgisSenseOf"/>
    


    <!-- http://w3.orgiso639P3PCode -->

    <AnnotationProperty rdf:about="http://w3.orgiso639P3PCode"/>
    


    <!-- http://w3.orglabel -->

    <AnnotationProperty rdf:about="http://w3.orglabel"/>
    


    <!-- http://w3.orglanguage -->

    <AnnotationProperty rdf:about="http://w3.orglanguage"/>
    


    <!-- http://w3.orgprefLabel -->

    <AnnotationProperty rdf:about="http://w3.orgprefLabel"/>
    


    <!-- http://w3.orgseeAlso -->

    <AnnotationProperty rdf:about="http://w3.orgseeAlso"/>
    


    <!-- http://w3.orgtype -->

    <AnnotationProperty rdf:about="http://w3.orgtype"/>
    


    <!-- http://w3.orgwrittenRep -->

    <AnnotationProperty rdf:about="http://w3.orgwrittenRep"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://w3.orginteger -->

    <rdfs:Datatype rdf:about="http://w3.orginteger"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://w3.orgConcept -->

    <Class rdf:about="http://w3.orgConcept"/>
    


    <!-- http://w3.orgLanguage -->

    <Class rdf:about="http://w3.orgLanguage"/>
    


    <!-- http://w3.orgLexicon -->

    <Class rdf:about="http://w3.orgLexicon"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.orgAlgic -->

    <NamedIndividual rdf:about="http://example.orgAlgic">
        <rdf:type rdf:resource="http://w3.orgConcept"/>
        <http:w3.orgprefLabel xml:lang="en">Algic</http:w3.orgprefLabel>
        <http:w3.orgseeAlso rdf:resource="https://glottolog.org"/>
    </NamedIndividual>
    


    <!-- http://example.orgAlgonquian -->

    <NamedIndividual rdf:about="http://example.orgAlgonquian">
        <rdf:type rdf:resource="http://w3.orgConcept"/>
        <http:w3.orgbroader rdf:resource="http://example.orgAlgic"/>
        <http:w3.orgprefLabel xml:lang="en">Algonquian</http:w3.orgprefLabel>
        <http:w3.orgseeAlso rdf:resource="https://glottolog.org"/>
    </NamedIndividual>
    


    <!-- http://example.orgCentralAlgonquian -->

    <NamedIndividual rdf:about="http://example.orgCentralAlgonquian">
        <rdf:type rdf:resource="http://w3.orgConcept"/>
        <http:w3.orgbroader rdf:resource="http://example.orgAlgonquian"/>
        <http:w3.orgcomment xml:lang="en">Areal/geographic grouping, not an established genetic subgroup</http:w3.orgcomment>
        <http:w3.orgprefLabel xml:lang="en">Central Algonquian</http:w3.orgprefLabel>
    </NamedIndividual>
    


    <!-- https://miamioh.edulanguage -->

    <NamedIndividual rdf:about="https://miamioh.edulanguage">
        <rdf:type rdf:resource="http://w3.orgLanguage"/>
        <http:example.orgglottocode rdf:resource="https://glottolog.org"/>
        <http:example.orglanguageFamily rdf:resource="http://example.orgCentralAlgonquian"/>
        <http:w3.orgiso639P3PCode>mia</http:w3.orgiso639P3PCode>
        <http:w3.orglabel xml:lang="en">Miami-Illinois (Myaamia / Irenwa)</http:w3.orglabel>
    </NamedIndividual>
    


