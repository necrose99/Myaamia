      <sense id="s_d1e46">
         <gloss lang="en">
            <text>dog-ERG cat-ABS see-PST-CAUS-NPST</text>
         </gloss>
         <gloss lang="en">
            <text>The dog made the cat see (it).</text>
         </gloss>
         <gloss lang="fr">
            <text>Le chien a fait voir au chat.</text>
         </gloss>
         <example>
            <form lang="tww">
               <text>ama-ki misi-ki wara-turu</text>
