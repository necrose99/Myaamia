   <entry id="e_tww_ama%20maka%20buru_d1e40">
      <lexical-unit>
         <form lang="tww">
            <text>ama maka buru</text>
         </form>
      </lexical-unit>
      <pronunciation>
         <form lang="tww-fonipa">
            <text its:translate="no">ˈa.ma ˈma.ka ˈbu.ɾu</text>
         </form>
      </pronunciation>
      <note type="morph-segmentation" its:translate="no">ama  maka  bur-u</note>
      <sense id="s_d1e40">
         <gloss lang="en">
            <text>dog eat eat-NPST</text>
         </gloss>
         <gloss lang="en">
            <text>The dog is eating.</text>
         </gloss>
         <gloss lang="fr">
            <text>Le chien mange.</text>
         </gloss>
         <example>
            <form lang="tww">
               <text>ama maka buru</text>
            </form>
            <translation type="Frame sentence">
               <form lang="en">
                  <text>The dog is eating.</text>
               </form>
            </translation>
            <translation type="Frame sentence">
               <form lang="fr">
                  <text>Le chien mange.</text>
               </form>
            </translation>
         </example>
      </sense>
      <note type="etym" its:translate="no">**ama [proto-tww] "dog"</note>
   </entry>
   <entry id="e_tww_ama-ki%20misi-ki%20wara-turu_d1e46">
      <lexical-unit>
