               <form lang="en">
                  <text>The dog made the cat see (it).</text>
               </form>
            </translation>
            <translation type="Frame sentence">
               <form lang="fr">
                  <text>Le chien a fait voir au chat.</text>
               </form>
            </translation>
         </example>
      </sense>
   </entry>
