   <file original="ref@SP1.a1"
         source-language="tww"
         target-language="en"
         datatype="eaf"
         its:version="1.0">
      <header>
         <tool tool-id="eaf-to-xliff" tool-name="eaf-to-xliff.xsl"/>
         <note>EAF utterance-id: U1</note>
         <note>speaker: SP1</note>
         <note its:translate="no">time-start-ms: 0</note>
         <note its:translate="no">time-end-ms: 1800</note>
         <note type="psychoacoustic" its:translate="no">F0_mean=180Hz; intensity=72dB; VOT=+25ms; aspiration=no</note>
         <note its:translate="no">OLAC-type: http://www.language-archives.org/REC/type.html#primary_text</note>
      </header>
      <body>
         <trans-unit id="a1.utt" resname="utterance">
            <source xml:lang="tww">ama maka buru</source>
            <target xml:lang="en">The dog is eating.</target>
            <note type="ipa" its:translate="no">ˈa.ma ˈma.ka ˈbu.ɾu</note>
            <note type="morph" its:translate="no">ama  maka  bur-u</note>
            <note type="gloss" its:translate="no">dog  eat  eat-NPST</note>
            <note type="etymology" its:translate="no">{"langCode":"proto-tww","text":"*ama","reconstructed":true,"translation":"dog"}</note>
            <context-group name="time-alignment" purpose="location">
               <context context-type="x-eaf-time-start">0</context>
               <context context-type="x-eaf-time-end">1800</context>
            </context-group>
         </trans-unit>
         <trans-unit id="a1.trans.fr" resname="translation">
            <source xml:lang="tww">ama maka buru</source>
            <target xml:lang="fr">Le chien mange.</target>
         </trans-unit>
      </body>
