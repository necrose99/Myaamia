			guid="5d9ef67a-e4ba-47ca-8c8c-ea0f512a66cd"
			id="4.3.4.5.3 Entrust to the care of"
			parent="4.3.4.5 Share with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to entrusting something to the care of someone.</text>
