			parent="7.5 Arrange">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to substituting something for something else--to move something and put something else in its place.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Substitute</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.6</text>
				</form>
			</abbrev>
		</range-element>
