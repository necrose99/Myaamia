			id="2.6.1.1 Arrange a marriage"
			parent="2.6.1 Marriage">
			<description>
				<form
					lang="en">
					<text>Use this domain for all the words related to arranging a marriage. Cultures vary widely in their practices. In some cultures marriages are arranged by the parents. In other cultures a man must seek a wife for himself. Some cultures allow either practice or a combination of the two. So some of the questions below may be inappropriate to your culture.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Arrange a marriage</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.6.1.1</text>
				</form>
