			parent="3.1.2 Mental state">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to noticing something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Notice</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.1.2.2</text>
				</form>
			</abbrev>
