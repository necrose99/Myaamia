			guid="be2f2785-7219-4a35-b8d3-aa56b9b78514"
			id="7.5.7 Multiple things moving"
			parent="7.5 Arrange">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to multiple things moving.</text>
