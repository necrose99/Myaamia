			parent="3.5.1.1 Voice">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to speaking poorly.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Speak poorly</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
