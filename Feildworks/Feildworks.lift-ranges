			guid="be4a63e7-f4ba-4de2-be69-d26219d99cb6"
			id="7.7.3 Kick"
			parent="7.7 Physical impact">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to kicking--to hit something with your foot. The words in this domain may be distinguished by the way in which the foot moves, either in a swinging motion, or by first bending the leg and then quickly straightening it. They may also be distinguished by whether the foot moves horizontally or vertically, whether the effect is to move something or damage it, or how hard the person kicks.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Kick</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.7.3</text>
				</form>
			</abbrev>
		</range-element>
