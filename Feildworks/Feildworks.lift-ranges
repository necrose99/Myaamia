		</range-element>
		<range-element
			guid="9f3b4cab-dc8a-430e-88f3-d3002df64fb8"
			id="7.1 Posture"
			parent="7 Physical actions">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words indicating the posture or stance of a person's body. Use the domains in this section for specific words for postures and for moving parts of the body. Many of these words have two meanings. One meaning is stative, indicating that the body is in a particular posture, but not moving. The other meaning is active, indicating that the person is moving his body into a particular posture. Some of these words can be used of animals or even things, if the things are perceived as being similar in posture to that of a human body.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Posture</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8841af5e-74e6-4c5d-a313-ba9aa7fdb78b"
			id="7.1.1 Stand"
			parent="7.1 Posture">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to standing. The words in this domain may include whether the person is standing on one foot or two, whether the person's feet are together or placed apart, whether something is between the person's feet, how fast the person stands up.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Stand</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="975d0109-1bba-4b0e-85b8-2c6b51c8e074"
			id="7.1.2 Sit"
			parent="7.1 Posture">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to sitting and squatting.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sit</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0aae0254-dc06-4906-8ecf-2d8450fb83f1"
			id="7.1.3 Lie down"
			parent="7.1 Posture">
			<description>
				<form
