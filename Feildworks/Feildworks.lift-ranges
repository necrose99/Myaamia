				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="4445cccd-e9b9-4f25-9e8c-2ef58408297d"
			id="5.3.7 Wear clothing"
			parent="5.3 Clothing">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to wearing clothing.</text>
				</form>
			</description>
			<label>
