					lang="en">
					<text>Use this domain for general words referring to communication of all kinds.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Communication</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5</text>
				</form>
			</abbrev>
		</range-element>
