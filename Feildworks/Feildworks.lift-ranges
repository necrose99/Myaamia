			parent="4.9.3 Theology">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to sacred writings. Examples are only given for the Christian sacred writings. However you should include words referring to the holy books of all religions .</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sacred writings</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.9.3.1</text>
				</form>
			</abbrev>
		</range-element>
