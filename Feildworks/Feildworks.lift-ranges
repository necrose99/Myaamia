			guid="878a313b-a201-444e-8bdb-67048d60c63e"
			id="3.1.2.4 Ignore"
			parent="3.1.2 Mental state">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to ignoring someone--to not look at, listen to, or talk to someone because you think they are not important or you don't like them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Ignore</text>
