		<range-element
			guid="b3745f13-3632-4f13-b0cc-a74c51f8f2a1"
			id="1.2.1.7 Earthquake"
			parent="1.2.1 Land">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to earthquakes. In some languages earthquakes are thought of as moving somewhere. In Amele (PNG) they say "mim nen" which means 'the earthquake came down (from above)'. In Northern Embera an earthquake is a "house-shaking". They say "a house-shaking went."</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Earthquake</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.2.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f899802d-bd32-427f-a101-c84219f7e14e"
