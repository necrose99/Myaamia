			guid="bdaecf2f-d0fa-49f7-891e-bcb0a31ae630"
			id="8.4.5.2.1 After"
			parent="8.4.5.2 Before">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to one event happening after another.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>After</text>
				</form>
			</label>
