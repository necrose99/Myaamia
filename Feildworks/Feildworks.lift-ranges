			id="8.3.7.7 Right, proper"
			parent="8.3.7 Good">
			<description>
				<form
					lang="en">
					<text>Use this domain for words describing something, such as a tool or way of doing something, that is proper for a particular time, place, purpose, or job. The words in this domain involve a comparison between two things, an item and a setting. An evaluation is made as to how good the item is in the setting. The words may be used only of certain types of items, certain types of settings, or certain types of usefulness.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Right, proper</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.3.7.7</text>
				</form>
