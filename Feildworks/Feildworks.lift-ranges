					lang="en">
					<text>Use this domain for words related to talking about a subject.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Talk about a subject</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
