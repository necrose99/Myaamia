			guid="bd9de99f-6a92-47ee-b6bc-e9877ea21202"
			id="7.6.2 Find"
			parent="7.6 Hide">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to finding something that has been hidden or lost.</text>
