			guid="39611e8d-cc67-4c84-977c-094c5cbe9dbc"
			id="3.4.2.1.5 Lonely"
			parent="3.4.2.1 Sad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling lonely--to feel bad because you are alone and not with people you love.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Lonely</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="bfe8902a-32a7-4092-93b2-9dcf3dce205f"
			id="3.4.2.1.6 Upset"
			parent="3.4.2.1 Sad">
			<description>
				<form
					lang="en">
					<text>Use this domain for word related to feeling upset--to feel very bad because someone has done something bad to you or because something bad has happened to you, so that your thinking and behavior is affected.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Upset</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="67d10a00-fda8-4a3a-becd-f3ae3b00fcca"
			id="3.4.2.1.7 Shock"
			parent="3.4.2.1 Sad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling shocked--feeling both surprised and angry when something very bad suddenly happens or when someone does something very bad.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Shock</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="262fc4ae-7735-465b-934b-2125d95de147"
			id="3.4.2.1.8 Jealous"
			parent="3.4.2.1 Sad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling jealous--to feel bad when someone does well, has something good, receives something good, or something good happens to them, because you want what they have. Also use this domain for words for when a husband (or wife) is jealous because he thinks his wife loves someone else.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Jealous</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.1.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f3654a7f-d16e-4870-9ef0-4b4268faeffb"
			id="3.4.2.1.9 Discontent"
			parent="3.4.2.1 Sad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling discontent.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Discontent</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.1.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="da39c0d9-a5c1-4f10-bd3b-4e988abcab5a"
			id="3.4.2.2 Sorry"
			parent="3.4.2 Feel bad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling sorry--to feel bad about something bad that you did.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sorry</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="43cb3488-711b-4d9d-9d0e-03d0c1f6eb8b"
			id="3.4.2.2.1 Ashamed"
			parent="3.4.2.2 Sorry">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling ashamed--to feel bad because people think you did something bad.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Ashamed</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e08e252a-9227-42e4-bcb8-b803d25071b6"
			id="3.4.2.2.2 Embarrassed"
			parent="3.4.2.2 Sorry">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling embarrassed--to feel bad in front of other people because you did or said something that makes you seem stupid.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Embarrassed</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2a62f8e4-7da3-4f37-bf44-e24033c99c00"
			id="3.4.2.3 Angry"
			parent="3.4.2 Feel bad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling angry--to feel bad when someone does something wrong and to want to do something bad to them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Angry</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8ce6709f-f772-4638-a1aa-c132666f3563"
			id="3.4.2.3.1 Annoyed"
			parent="3.4.2.3 Angry">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling annoyed--to feel a little angry because someone keeps doing something you don't like.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Annoyed</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2b6f9af7-04ee-4030-a2cd-87d55959caa8"
			id="3.4.2.4 Afraid"
			parent="3.4.2 Feel bad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to fear--to feel bad because you think something bad might happen to you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Afraid</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ba1e8d2b-7d3e-4b65-a9be-ee1a4063c796"
			id="3.4.2.4.1 Worried"
			parent="3.4.2.4 Afraid">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling worried--to feel bad because you think something bad might happen.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Worried</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="64e3d6b1-1d61-454c-97ab-e1d7cb0a8917"
			id="3.4.2.4.2 Nervous"
			parent="3.4.2.4 Afraid">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling nervous--to be worried and frightened that something bad may happen, so that you are unable to relax.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Nervous</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="100e62a6-b6f4-4b30-b317-0517d6b102a9"
			id="3.4.2.4.3 Shy, timid"
			parent="3.4.2.4 Afraid">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling shy--to feel bad (afraid) when you are with people because you think they might think something bad about you if you say or do something (for instance, being afraid to talk, feeling inadequate to do what is required in a social situation, or not feeling as good as other people).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Shy, timid</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8052744f-7a9a-49da-89e3-4c518126180b"
			id="3.4.2.5 Confused"
			parent="3.4.2 Feel bad">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling confused--to be worried and uncertain about what something means or what to do.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Confused</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.4.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c9aee4df-ac3e-4159-bd1a-060db1a5f070"
			id="3.5 Communication"
			parent="3 Language and thought">
