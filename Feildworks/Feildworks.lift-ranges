			guid="d1b3d0f0-5319-4a6a-8a70-2179a8e76d22"
			id="8.1.7.3 Need"
			parent="8.1.7 Enough">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to needing something for some purpose.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Need</text>
				</form>
			</label>
