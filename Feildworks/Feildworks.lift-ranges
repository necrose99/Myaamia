			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a corpse--the body of a person who has died.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Corpse</text>
