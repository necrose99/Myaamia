			<description>
				<form
					lang="en">
					<text>Use this domain for words related to hoping that something will happen--to want something good to happen in the future.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Hope</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.2.7.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="218c1d59-0ebb-4936-b9cf-0a93e88aa729"
			id="3.2.7.2 Hopeless"
			parent="3.2.7 Expect">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to feeling hopeless--to thinking that nothing good will happen in the future.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Hopeless</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.2.7.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c956a98a-4c85-4c85-868d-f27f44bd6422"
			id="3.2.7.3 Predict"
			parent="3.2.7 Expect">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to predicting the future--saying what you think will happen.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Predict</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.2.7.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="05f95abb-163a-4927-83c5-8c81ef7b769c"
			id="3.2.8 Tendency"
			parent="3.2 Think">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that the speaker thinks that something tends to be a certain way.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tendency</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.2.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b50f39cb-3152-4d56-9ddc-4b98f763e76a"
			id="3.3 Want"
			parent="3 Language and thought">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to wanting something or wanting to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Want</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="af4ac058-d4b3-4c7a-ade8-6af762d0486d"
			id="3.3.1 Decide, plan"
			parent="3.3 Want">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to deciding to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Decide, plan</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b6b73d41-e23f-4f22-b01e-7e75f4115fce"
			id="3.3.1.1 Purpose, goal"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a goal--something that you want to do or something that you want to happen.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Purpose, goal</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fed2b7bd-2315-4085-b0a7-2ced988120f3"
			id="3.3.1.2 Choose"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to choosing something--to want one thing (or person) from a group of things, or to choose to do one thing from several possible things you could do.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Choose</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7337b2dd-b574-4a41-affa-2dfad7f6cdbc"
			id="3.3.1.3 Cast lots"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to casting lots--to make a decision by chance.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Cast lots</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7bf77556-64df-428e-bfdd-095af5bfeeda"
			id="3.3.1.4 Intend"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to intending to do something--to do something intentionally and not by accident.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Intend</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="26bc089a-a989-4763-be6c-05d127d1c0e8"
			id="3.3.1.5 Deliberately"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to doing something deliberately--to intend to do something, as opposed to doing something accidentally.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Deliberately</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="15fb022e-1b45-41e9-bd8a-09ddc9dc6acd"
			id="3.3.1.6 Determined"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being determined to do something--deciding to do something and not letting anything stop you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Determined</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cc121082-2d07-484e-8a6f-7382f7d71f39"
			id="3.3.1.7 Stubborn"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being stubborn--to be unwilling to change a decision; to be unwilling to do something someone wants you to do; or to do what you want to do, even though other people do not want you to do it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Stubborn</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="41b80f5d-0298-4d3c-b1a3-6d5e6c3985b1"
			id="3.3.1.8 Lust"
			parent="3.3.1 Decide, plan">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to lusting for something--to want something bad or forbidden.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Lust</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.1.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="45f7b003-ade3-4efc-8dee-259dcbf80a4a"
			id="3.3.2 Request"
			parent="3.3 Want">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to requesting something--to ask for something, or ask someone to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Request</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d2e73238-ff99-4ba3-8ce6-d8ae98721710"
			id="3.3.2.1 Agree to do something"
			parent="3.3.2 Request">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to agreeing to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Agree to do something</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1137590c-6f2f-4b69-b04e-f6a890a335a2"
			id="3.3.2.2 Refuse to do something"
			parent="3.3.2 Request">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to refusing to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Refuse to do something</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="593073d6-9893-4670-98fb-c485406a950b"
			id="3.3.2.3 Intercede"
			parent="3.3.2 Request">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to interceding for someone--to say something to someone because you want them to do something good for someone else.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Intercede</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6b19e828-f597-4d0d-b7a6-f52f3bbd041f"
			id="3.3.2.4 Willing"
			parent="3.3.2 Request">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being willing to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Willing</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5ea9301a-9906-4e81-97cf-48ee95a54c63"
			id="3.3.3 Influence"
			parent="3.3 Want">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to influencing someone--to do something because you want someone to change his thinking.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Influence</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8ea4e0d4-71a2-4583-a1fe-f1a941af8478"
			id="3.3.3.1 Suggest"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to suggesting something--saying that something might be good.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Suggest</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6bfb7813-3a7d-47e2-88e1-d54034c07e5d"
			id="3.3.3.2 Advise"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to giving someone advice or counsel, for instance recommending a wise course of action.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Advise</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9d428e57-e125-4575-b165-9bc6fd4ec507"
			id="3.3.3.3 Persuade"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to persuading someone--to try to get someone to do something or to change his thinking.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Persuade</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ad56dc48-9c39-43f6-9386-f7df80d93cd4"
			id="3.3.3.4 Insist"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to insisting--to say strongly or repeatedly that someone must do something, because the other person does not want to do it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Insist</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6fbe39fb-a4cb-4fcf-830b-8875fd4324e0"
			id="3.3.3.5 Compel"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to compelling someone to do something--to cause or force someone to do something that they do not want to do.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Compel</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e6ec43ef-0100-4cf4-a047-c575ee8613b4"
			id="3.3.3.6 Control"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to controlling someone--to force someone to do what you want them to do by ordering them to do it, or by doing something so that they have no choice. Also use this domain for words related to controlling something, for instance to control a machine, so that it does what you want it to do.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Control</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3445e61b-61a3-4ede-93f5-402ebe9ca51c"
			id="3.3.3.7 Warn"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to warning someone--saying something to someone so that he will not do something bad.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Warn</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c1c1dcb4-8fe5-43ac-9b91-b2b2bc33de5b"
			id="3.3.3.8 Threaten"
			parent="3.3.3 Influence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to threatening someone--to say that you will do something bad to someone if they don't do what you want them to do.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Threaten</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.3.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8383b4cb-e14a-4d04-a8c3-9c5276384953"
			id="3.3.4 Ask permission"
			parent="3.3 Want">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to asking permission to do something. This domain is part of a scenario: You have authority over me. I want to do something. I ask you for permission to do it. You give permission or refuse permission. I obey you or disobey you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Ask permission</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a3e905b8-107b-4311-bb50-0abe151131b3"
			id="3.3.4.1 Give permission"
			parent="3.3.4 Ask permission">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to giving someone permission to do something. This domain is about a scenario: You have authority over me. I want to do something. I ask you for permission to do it. You give permission or refuse permission.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Give permission</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8f46496a-d5b2-411d-944d-9d4d4b6f2e31"
			id="3.3.4.2 Refuse permission"
			parent="3.3.4 Ask permission">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to refusing to permit someone to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Refuse permission</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b6baa8bf-7691-431d-8715-3937372b9da0"
			id="3.3.4.3 Exempt"
			parent="3.3.4 Ask permission">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being exempt from a law or obligation.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Exempt</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="66fc9a08-3661-4dd5-94b0-1eea41fb4554"
			id="3.3.4.4 Prevent"
			parent="3.3.4 Ask permission">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to preventing someone from doing something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Prevent</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.3.4.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c8c74ec6-3f7a-4b45-b0e9-399b97c4a800"
