				<form
					lang="en">
					<text>Use this domain for words related to cooperating with someone to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Cooperate with</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="92e441df-7e56-4e2c-b205-79a95800f567"
			id="4.3.4.3.1 Compete with"
			parent="4.3.4.3 Cooperate with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to competing with someone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Compete with</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4.3.1</text>
				</form>
			</abbrev>
