			guid="c817af65-7cc8-4105-a8ed-47067d97b73b"
			id="5.3.5 Clothes for special people"
			parent="5.3 Clothing">
			<description>
				<form
					lang="en">
					<text>Use this domain for special clothes worn by special people. It is necessary to think through all the various special types of people in the culture and think of any special clothes worn by them. Several examples are given below, but there are many others.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Clothes for special people</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
