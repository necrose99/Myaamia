		<range-element
			guid="7c80f6ee-e76d-4903-aee6-7a33d1da3f75"
			id="7.3.7 Cover"
			parent="7.3 Move something">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to covering something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Cover</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.3.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5b925ee1-82ef-4692-bba2-9ce3cb41c7bb"
			id="7.3.7.1 Uncover"
			parent="7.3.7 Cover">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to uncovering something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Uncover</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.3.7.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2608bcf8-ed20-4501-8510-4ecacf922dd4"
			id="7.3.7.2 Wrap"
			parent="7.3.7 Cover">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to wrapping something--to cover something on all sides with something like leaves, cloth, or paper.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Wrap</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.3.7.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a2240259-608b-40f1-990a-7f8e00ef1d07"
			id="7.3.7.3 Spread, smear"
			parent="7.3.7 Cover">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to spreading something--to cover something on all sides with something liquid or sticky like paint or mud.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Spread, smear</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.3.7.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="991357dc-9f56-47ed-8790-85cbd5f9b06f"
			id="7.3.8 Transport"
			parent="7.3 Move something">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to moving something in a vehicle.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Transport</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.3.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="24398eec-edd1-449a-ad36-d609be24a79e"
			id="7.4 Have, be with"
			parent="7 Physical actions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to having something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Have, be with</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4</text>
				</form>
