		<range-element
			guid="56d1a950-8798-45fb-bccd-d8b1eb37c071"
			id="7.4.1 Give, hand to"
			parent="7.4 Have, be with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to giving something to someone, in which there is no transaction of ownership, merely the movement of the thing from one person to another.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Give, hand to</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c96ac1eb-12f2-47af-9e96-9d99fce7e8f5"
			id="7.4.2 Receive"
			parent="7.4 Have, be with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to receiving something from someone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Receive</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="adfc2bcd-6b8e-486c-b105-29b286b61cc0"
			id="7.4.3 Get"
			parent="7.4 Have, be with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to getting something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Get</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="86c065ea-2420-4619-82d4-1d43527b3371"
			id="7.4.4 Distribute"
			parent="7.4 Have, be with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to distributing things to several people.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Distribute</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7df3078c-f681-4123-a712-4b83e438ea1d"
			id="7.4.5 Keep something"
			parent="7.4 Have, be with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to keeping something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Keep something</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1b3dccfe-29e4-478e-8443-17be9454a05a"
			id="7.4.5.1 Leave something"
			parent="7.4.5 Keep something">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to leaving something or someone in a place and going away.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Leave something</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6c32038c-adf3-4085-bde3-cd2f21a421ba"
			id="7.4.5.2 Throw away"
			parent="7.4.5 Keep something">
			<description>
				<form
					lang="en">
					<text>Use this domain for throwing away something that you no longer want.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Throw away</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e7119442-3063-422a-a03e-d02e570ccd0f"
			id="7.4.6 Not have"
			parent="7.4 Have, be with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to having something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Not have</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.4.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6045c6eb-efea-4586-95f8-840d32578d66"
			id="7.5 Arrange"
			parent="7 Physical actions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to arranging things--to physically move a group of things or people and put them in a pattern.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Arrange</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c16334a0-be29-4a1e-a870-4cb3f1df984d"
			id="7.5.1 Gather"
			parent="7.5 Arrange">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to gathering things into a group. The basic idea of this domain involves a situation in which two or more things are not together, and someone moves them so that they are together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Gather</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="30b3faa8-747e-465f-833a-a9957a259be2"
			id="7.5.1.1 Separate, scatter"
			parent="7.5.1 Gather">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to separating things into groups, and scattering things. The basic idea of this domain involves a situation in which two or more things are together, and someone moves them so that they are no longer together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Separate, scatter</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="71b19b9e-231c-4196-a7d7-aa56a5079782"
			id="7.5.1.2 Include"
			parent="7.5.1 Gather">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to including something in a group.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Include</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b7f058af-9ce6-4dd0-b555-00526975300e"
			id="7.5.1.3 Special"
			parent="7.5.1 Gather">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe a member of a group that is different or special.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Special</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="08239f53-daa5-47a6-9f39-29a9064b0c27"
			id="7.5.2 Join, attach"
			parent="7.5 Arrange">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to joining two or more things together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Join, attach</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6ab060ca-ecfc-4a46-accb-42b0473998cd"
			id="7.5.2.1 Link, connect"
			parent="7.5.2 Join, attach">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to a linking or connecting things together--to put something like a road, pipe, or wire between things so that people or things can move between them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Link, connect</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e43c9905-ae67-4627-8b10-bd7a453828b4"
			id="7.5.2.2 Stick together"
			parent="7.5.2 Join, attach">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to two or more things cohering or sticking together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Stick together</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2b27b8ca-188e-44ad-aa86-ffa1f99106e3"
			id="7.5.2.3 Add to something"
			parent="7.5.2 Join, attach">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to adding something to another thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Add to something</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a31c85df-02a9-4dd8-a094-0f07a0afbcca"
			id="7.5.2.4 Remove, take apart"
			parent="7.5.2 Join, attach">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to removing part of something, taking something apart, and things coming apart.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Remove, take apart</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fe58ae61-ab0b-43a4-86fb-d9aedd199932"
			id="7.5.3 Mix"
			parent="7.5 Arrange">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to mixing things together--to put two or more different kinds of substances, like liquids or cooking ingredients, together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9b158c9e-9ba5-4be2-a9a1-77ef888a3b06"
			id="7.5.3.1 Pure, unmixed"
			parent="7.5.3 Mix">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being pure--words describing something (like water, food, or air) that does not have anything bad in it; or unmixed--words describing something that is only one thing and has not been mixed with something else.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Pure, unmixed</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9b267cc1-983c-407a-98d2-1e27add6292c"
			id="7.5.4 Tie"
			parent="7.5 Arrange">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to tying things together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tie</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="761706fe-d289-4ace-b2c3-ab15d80dba7f"
			id="7.5.4.1 Rope, string"
			parent="7.5.4 Tie">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to rope, string, and other things used to tie things together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Rope, string</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5f791daf-98a2-4787-93cc-8813aea93c4d"
			id="7.5.4.2 Tangle"
			parent="7.5.4 Tie">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to becoming tangled--when something long and thin, such as rope, string, thread, hair, grass, or vines, becomes disorganized, twisted, or knotted, so that it is hard to separate it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tangle</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e6c9fe4c-199e-4934-b622-739a85b0830d"
			id="7.5.5 Organize"
			parent="7.5 Arrange">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to organizing things, people, events, and ideas--to think about and decide on the pattern a group of things should be arranged in, and then doing whatever is necessary to arrange them so that they can be used for some purpose. This domain is like the domain 'Arrange' except that 'Arrange' emphasizes physically moving the things, and the domain 'Organize' emphasizes the logical system. 'Organize' does not require that the things be moved, only that the logical pattern is specified.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Organize</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="583c98ff-1cc8-4b05-9086-974d13a78894"
			id="7.5.5.1 Disorganized"
			parent="7.5.5 Organize">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to things becoming disorganized.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Disorganized</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.5.5.1</text>
				</form>
			</abbrev>
