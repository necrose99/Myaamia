		<range-element
			guid="c3b808d4-d94e-4c8e-b7b2-87b4f4a83198"
			id="5.3.4 Clothes for special occasions"
			parent="5.3 Clothing">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to special clothes worn on special occasions. It is necessary to think through all the various special occasions in the culture and think of any special clothes worn on those occasions. Two examples are given below for work and graduation, but there are many others.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Clothes for special occasions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>5.3.4</text>
				</form>
			</abbrev>
		</range-element>
