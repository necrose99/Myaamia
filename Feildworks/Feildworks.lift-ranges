				<form
					lang="en">
					<text>Use this domain for words related to narcotics and drugs that are not used as medicine but as stimulants. Narcotics are often addicting and harmful to a person's health.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Narcotic</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>5.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="029e0760-3306-41cc-b032-40befb22303e"
			id="5.2.6 Stimulant"
			parent="5.2 Food">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to stimulants--substances that are drunk, eaten, or chewed to make a person more alert or give him more energy.</text>
