			guid="7185bd93-5281-46de-80af-767f0ec40ff6"
			id="3.2.1 Mind"
			parent="3.2 Think">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words referring to the mind--the part of a person that thinks.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mind</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.2.1</text>
