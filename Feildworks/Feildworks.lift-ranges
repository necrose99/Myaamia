		<range-element
			guid="8e11dd10-459b-4fb3-b876-7d80ec5f8a4d"
			id="4.3 Behavior"
			parent="4 Social behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words referring to a person's behavior.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Behavior</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3</text>
				</form>
