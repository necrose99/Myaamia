			guid="1ec85151-eba0-48f4-b56d-4f8040602a4b"
			id="2.6.6.7 Inherit"
			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to inheriting something from your parents after they die.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Inherit</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.6.6.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0281fb1d-ab12-41b9-a3dc-09ef6b1e4733"
			id="2.6.6.8 Life after death"
			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to life after death.</text>
				</form>
			</description>
			<label>
