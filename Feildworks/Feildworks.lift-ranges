			guid="8a81b9bc-9c66-4d57-a2d1-2e592604c4b1"
			id="8.1.8 Full"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a container being full of something.</text>
