		<range-element
			guid="8497fb66-8b91-46b9-a0d5-fb9385319561"
			id="2.3.3 Taste"
			parent="2.3 Sense, perceive">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to tasting something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Taste</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.3</text>
				</form>
			</abbrev>
