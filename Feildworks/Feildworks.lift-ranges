			guid="e6221c7a-4608-4114-ba9f-532a3b943113"
			id="1.6.2.1 Parts of a bird"
			parent="1.6.2 Parts of an animal">
			<description>
				<form
					lang="en">
					<text>Use this domain for the parts of a bird, but not general parts that belong to all animals.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Parts of a bird</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.2.1</text>
				</form>
