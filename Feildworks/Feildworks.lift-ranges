		<range-element
			guid="24361be2-49be-4860-bb56-4e46dd1e8b0c"
			id="4.9.5.6.1 Taboo"
			parent="4.9.5.6 Religious purification">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to things that are taboo--something to be avoided; a religious, social, or cultural restriction on behavior, as opposed to a government law.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Taboo</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.9.5.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6105a207-4311-4920-8c19-63259424bfaf"
			id="4.9.5.7 Salvation"
			parent="4.9.5 Practice religion">
			<description>
				<form
					lang="en">
					<text>Use this domain for the primary goal or goals of a religion, for instance in Christianity salvation from sin, death and Hell. Each religion has different beliefs about salvation. Our purpose here is not to preach or argue, but to list those words that people use to talk about this topic.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Salvation</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.9.5.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="62ed8254-e53a-4781-935e-79869619e40a"
			id="4.9.5.8 Dedicate to religious use"
			parent="4.9.5 Practice religion">
