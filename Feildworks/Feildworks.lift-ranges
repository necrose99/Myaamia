				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="771e3882-f672-4e67-8580-edd82d7e5090"
			id="4.3.4 Do good to"
			parent="4.3 Behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to doing good to someone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Do good to</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4</text>
				</form>
			</abbrev>
		</range-element>
