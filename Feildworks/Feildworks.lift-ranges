		<range-element
			guid="7cfc8b3c-ad67-4928-ae6a-74afd47ced89"
			id="8.1.6 Whole, complete"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words describing a whole thing--all of something with no parts missing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Whole, complete</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="aadefee4-ed14-4753-952e-e945f2972e37"
			id="8.1.6.1 Part"
			parent="8.1.6 Whole, complete">
			<description>
				<form
					lang="en">
					<text>Many things have parts. Use this domain for words referring to a part of something, and for words that express the idea that something has parts, that something is a part of something, or that link the whole with a part.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Part</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1d34380d-61bf-4247-9145-ba318a14a97e"
			id="8.1.6.2 Piece"
			parent="8.1.6 Whole, complete">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a part of something that has been broken or cut off.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Piece</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="286ee16c-a218-43d5-bbac-ab15f80c3fcf"
			id="8.1.7 Enough"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being or having enough--to have as much of something or as many of something as you need or want.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Enough</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.7</text>
				</form>
			</abbrev>
