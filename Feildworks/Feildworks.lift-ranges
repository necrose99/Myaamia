		<range-element
			guid="48ac206f-2706-4500-bb63-2e499b790259"
			id="3.2.1.3 Intelligent"
			parent="3.2.1 Mind">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe a person who thinks well.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Intelligent</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.2.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1f3519f8-d946-4857-a1fd-553d98dddf6d"
			id="3.2.1.4 Stupid"
			parent="3.2.1 Mind">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe a person who does not think well.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Stupid</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.2.1.4</text>
