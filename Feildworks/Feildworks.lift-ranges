			guid="7556a257-3703-40d3-91d3-c891fb250947"
			id="4.9 Religion"
			parent="4 Social behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words referring to religion and the supernatural.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Religion</text>
				</form>
			</label>
