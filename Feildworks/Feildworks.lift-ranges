				<form
					lang="en">
					<text>Use this domain for words referring to a mental state when the mind is working hard.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Attention</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.1.2.3</text>
				</form>
			</abbrev>
