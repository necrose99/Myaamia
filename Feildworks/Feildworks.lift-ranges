				<form
					lang="en">
					<text>2.6.6.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="32cf3835-bced-4ea1-9c7a-f7ff653e59fe"
			id="2.6.6.6 Grave"
			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to a grave--the place where a dead body is put.</text>
