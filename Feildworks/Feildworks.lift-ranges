			guid="1621aac3-4ea9-4373-bf1b-40fce0ca7b5e"
			id="8.1.7.2 Lack"
			parent="8.1.7 Enough">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to having insufficient--to not have enough.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Lack</text>
