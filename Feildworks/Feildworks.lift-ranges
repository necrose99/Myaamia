			guid="dc1ab28c-3e1e-474c-8359-2548b7ad5595"
			id="3.5.1.2.2 Describe"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to describing something--to say some things about something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Describe</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.2</text>
				</form>
			</abbrev>
