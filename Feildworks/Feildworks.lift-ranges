			guid="a2508183-7ea5-434e-a773-00d53087d27b"
			id="3.1.2 Mental state"
			parent="3.1 Soul, spirit">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a person's mental state.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mental state</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.1.2</text>
				</form>
			</abbrev>
		</range-element>
