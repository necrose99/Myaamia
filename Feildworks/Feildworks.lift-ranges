			guid="69d039e6-f669-4d54-8b67-89b19ff0a19c"
			id="8.4.5.2.3 During"
			parent="8.4.5.2 Before">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something happened during some time period, or that something happened while something else was happening.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>During</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.4.5.2.3</text>
				</form>
			</abbrev>
