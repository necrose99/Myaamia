			guid="e96f6860-0914-4324-9c49-48f24a0ff7f1"
			id="3.5.1.1.7 Speak well"
			parent="3.5.1.1 Voice">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to speaking well.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Speak well</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.1.7</text>
