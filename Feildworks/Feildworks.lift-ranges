			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to killing someone--to cause someone to die.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Kill</text>
				</form>
			</label>
