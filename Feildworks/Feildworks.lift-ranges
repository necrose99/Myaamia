				<form
					lang="en">
					<text>9.2.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2c576c40-17ae-45a7-9ec8-6c16e02ab9c3"
			id="9.2.5.2 Clause conjunctions"
			parent="9.2.5 Conjunctions">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all clause level conjunctions--conjunctions that join two clauses.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Clause conjunctions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ae04020a-3bb2-4672-ad75-71ce72d461ea"
			id="9.2.5.3 Sentence conjunctions"
			parent="9.2.5 Conjunctions">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all sentence level conjunctions--conjunctions that join two sentences.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sentence conjunctions</text>
