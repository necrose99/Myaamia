			guid="0a85ee64-e466-4295-8e2c-5b06c8e3054f"
			id="7.7.4 Press"
			parent="7.7 Physical impact">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to pressing something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Press</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.7.4</text>
