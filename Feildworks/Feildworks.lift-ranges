			guid="b9a4b336-080a-4973-a7e3-a9af10fc347c"
			id="2.1.8.2 Stomach"
			parent="2.1.8 Internal organs">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to the stomach and to the normal functions of the stomach. Do not use this domain for stomach illness.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Stomach</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.1.8.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7dbd7f43-4291-47f8-a392-6fdf3c98d522"
			id="2.1.8.3 Male organs"
			parent="2.1.8 Internal organs">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the male reproductive organs.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Male organs</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.1.8.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3d5d93ce-00e0-46ff-b220-553c12c38381"
			id="2.1.8.4 Female organs"
			parent="2.1.8 Internal organs">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the female reproductive organs and a woman's monthly menstrual cycle. Some of these terms may be taboo. Care must be exercised in which terms are included in the dictionary. A group of women should decide which terms are 'public' and can go in the dictionary, and which would be considered taboo, overly crude, or embarrassing. For example some societies have been afraid that their women will be taken advantage of if these terms are known.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Female organs</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.1.8.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7fe69c4c-2603-4949-afca-f39c010ad24e"
			id="2.2 Body functions"
			parent="2 Person">
			<description>
				<form
					lang="en">
					<text>Use this domain for the functions and actions of the whole body. Use the subdomains in this section for functions, actions, secretions, and products of various parts of the body. In each domain include any special words that are used of animals.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Body functions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a1959b00-9702-4b45-ac46-93f18d3bc5e6"
			id="2.2.1 Breathe, breath"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to breathing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Breathe, breath</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8b52a9d6-a07e-4ac8-8f84-6eb5ba578d97"
			id="2.2.2 Cough, sneeze"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to coughing, sneezing, and other actions of the mouth and nose.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Cough, sneeze</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="75825d72-695b-4e92-9f33-0f3ab4d7dd11"
			id="2.2.3 Spit, saliva"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to spitting.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Spit, saliva</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="591fd489-36e6-4ffd-a976-58876d851829"
			id="2.2.4 Mucus"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to mucus in the nose.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mucus</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8c41d2d1-6da6-4ab8-8b29-7e226192d64e"
			id="2.2.5 Bleed, blood"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to blood and bleeding.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Bleed, blood</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d395edc8-fb58-4ba4-8446-dacf8ea0477a"
			id="2.2.6 Sweat"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to sweating.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sweat</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e7f94aea-ba50-481d-b640-d5cd8bdedc72"
			id="2.2.7 Urinate, urine"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to urination.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Urinate, urine</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cbc24a98-1c64-467e-98aa-251a28e4c0b8"
			id="2.2.8 Defecate, feces"
			parent="2.2 Body functions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to defecation.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Defecate, feces</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.2.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="38bbb33a-90bf-4a2c-a0e5-4bde7e134bd9"
			id="2.3 Sense, perceive"
			parent="2 Person">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words related to all the senses--sight, hearing, smell, taste, and feeling. Some languages may not distinguish some of these senses, and some languages may have words for other senses. There are also other senses that animals have. If your language has words for other senses, include them here.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sense, perceive</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a8568a16-4c3b-4ce4-84a7-b8b0c6b0432f"
			id="2.3.1 See"
			parent="2.3 Sense, perceive">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to seeing something (in general or without conscious choice).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>See</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d7861def-70c1-470f-bca6-8230cbbaa3e9"
			id="2.3.1.1 Look"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that refer to looking at someone or something--to see something because you want to.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Look</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fda0c1ac-5728-4ba2-9f8e-827f161b5bb1"
			id="2.3.1.2 Watch"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that refer to watching someone or something--to look for some time at something that is happening because you are interested in it and want to know what is happening.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Watch</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="90c06635-a12c-4cd4-a190-46925ff0f43e"
			id="2.3.1.3 Examine"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to examining--to look carefully at something because you want to learn something about it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Examine</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="273f4956-f79f-4b1e-b552-466280a65e60"
			id="2.3.1.4 Show, let someone see"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to showing something to someone so that they can see it--to cause someone to see something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Show, let someone see</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3f4c559f-ab4f-411f-a23b-d2396c977005"
			id="2.3.1.5 Visible"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being able to see something--words that describe something that can be seen, something that cannot be seen, something that is easy to see, or something that is difficult to see.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Visible</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="79a33505-0c33-4e92-89b9-6a42e6ff2228"
			id="2.3.1.5.1 Appear"
			parent="2.3.1.5 Visible">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to something appearing (becoming visible) and disappearing (becoming invisible).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Appear</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cd6f1b37-5bdd-4237-8827-b1c947c8e1b4"
			id="2.3.1.6 Transparent"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe how well you can see through something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Transparent</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ec118a28-fd23-48b3-8819-bfe1329f028d"
			id="2.3.1.7 Reflect, mirror"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to reflecting light.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Reflect, mirror</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="4275df2e-d4f6-461a-9279-39e0712dc082"
			id="2.3.1.8 Appearance"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to how something appears.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Appearance</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e4517880-aa2d-4977-b55a-dcb0b6d1f533"
			id="2.3.1.8.1 Beautiful"
			parent="2.3.1.8 Appearance">
			<description>
				<form
					lang="en">
					<text>Use this domain for words describing someone or something that is beautiful--pleasing in appearance,.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Beautiful</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.8.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2f151c35-72e1-4665-bc05-6fc70a3ecff2"
			id="2.3.1.8.2 Ugly"
			parent="2.3.1.8 Appearance">
			<description>
				<form
					lang="en">
					<text>Use this domain for words describing someone or something that is ugly--not pleasing in appearance.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Ugly</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.8.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e4e05724-01ec-4c61-90f0-b8658cc8ca51"
			id="2.3.1.9 Something used to see"
			parent="2.3.1 See">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to glasses and other things people use to help them see.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Something used to see</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.1.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8503660c-03af-49ee-86b6-525aab4da828"
			id="2.3.2 Hear"
			parent="2.3 Sense, perceive">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to hearing something (in general or without conscious choice).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Hear</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0de28f92-c851-413c-bb6c-3ad21f5e267f"
			id="2.3.2.1 Listen"
			parent="2.3.2 Hear">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to listening--to deliberately hear something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Listen</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.2.1</text>
				</form>
			</abbrev>
		</range-element>
