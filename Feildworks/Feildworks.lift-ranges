		<range-element
			guid="cb362fc7-b3aa-46f4-b9a8-0f8c97fb16fe"
			id="6.2.1 Growing crops"
			parent="6.2 Agriculture">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words related to growing crops. If one crop is cultivated extensively and there are many words related to it, set up a separate domain for it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Growing crops</text>
