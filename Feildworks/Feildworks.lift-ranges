			id="8.3.1.4 Horizontal"
			parent="8.3.1 Shape">
			<description>
				<form
					lang="en">
					<text>Use this domain for words describing a horizontal orientation in relation to the ground or something that is level--a flat surface that does not rise in any direction. A person is horizontal when he is sleeping. A field is level when it is not on a hill and it has no uneven areas in it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Horizontal</text>
				</form>
			</label>
