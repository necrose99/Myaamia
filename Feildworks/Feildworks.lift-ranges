		<range-element
			guid="f4b77866-c607-43f0-b816-95459c269525"
			id="3.5.5 Foolish talk"
			parent="3.5 Communication">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to foolish talk--something someone says that other people think is silly or stupid.</text>
				</form>
