		<range-element
			guid="7524887a-5cf0-4459-96d1-fd8262bef7d4"
			id="6.2.1.2 Growing roots"
			parent="6.2.1 Growing crops">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to growing root crops such as beets, carrots, cassava, garlic, ginger, leeks, manioc, onions, peanuts, potatoes, radishes, rutabagas, taro, turnips, and yams. If one crop is cultivated extensively and there are many words related to it, set up a separate domain for it. This has already been done for potatoes and cassava, since they are so common around the world.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Growing roots</text>
				</form>
			</label>
			<abbrev>
