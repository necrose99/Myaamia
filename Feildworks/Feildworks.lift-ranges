					lang="en">
					<text>Block, dam up</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>7.3.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="440608df-3c98-4dc8-9fd3-fad08afe7aef"
			id="7.3.6.3 Limit"
			parent="7.3.6 Open">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a limit beyond which something may or should not go, and for words referring to imposing a limit.</text>
				</form>
			</description>
			<label>
