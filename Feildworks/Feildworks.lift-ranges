			guid="61f52196-a8b2-496d-96ea-8c15dc7d377a"
			id="4.9.4 Miracle, supernatural power"
			parent="4.9 Religion">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to miracles--the use of supernatural power to do something good.</text>
