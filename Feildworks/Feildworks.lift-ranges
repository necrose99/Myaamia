			id="3.5.1.2.6 Repeat"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to repeating something--saying something a second time.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Repeat</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="728bbc7c-e5b3-47d8-8532-72239e5c88bb"
			id="3.5.1.2.7 Summarize"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to summarizing what you have said or what someone else has said.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Summarize</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="49cd2c20-098a-46d9-9e47-6bf109308793"
			id="3.5.1.2.8 Emphasize"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to emphasizing something--to say something in a way that other people know that you think this thing is important.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Emphasize</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="06b23bcd-69df-471a-b5a5-4ca8cab7f0d9"
			id="3.5.1.2.9 Be about, subject"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that express the idea that something (said, written, thought, or made) depicts or is about a subject, or that something is logically related to some topic. Also use this domain for words that mark the topic or subject of what is being thought about, talked about, or written about. Verbs of thinking, knowing, or speaking (including other types of expression) can take a 'topic' role. We can think of a 'topic' as the main idea. Use this domain also for the important thing in a picture.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Be about, subject</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ac2e424b-6aee-4031-8864-7b3f4a6fb5a3"
			id="3.5.1.3 True"
			parent="3.5.1 Say">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate if something is true, if it agrees with reality, or if it is not true.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>True</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3bc961d1-9f4f-4f1b-ada7-b1e9a2928ea4"
			id="3.5.1.3.1 Tell the truth"
			parent="3.5.1.3 True">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to telling the truth.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tell the truth</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9f0bcab1-8256-47a1-853c-408f025e04e7"
			id="3.5.1.3.2 Tell a lie"
			parent="3.5.1.3 True">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to lying--to say something that is not true.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tell a lie</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="02b6da2b-fae3-49f4-83f0-fd014024e117"
			id="3.5.1.3.3 Contradict"
			parent="3.5.1.3 True">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to contradicting someone--to say that something someone has said is not true.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Contradict</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="016e3f5b-b527-446e-9da6-49af34870001"
			id="3.5.1.3.4 Expose falsehood"
			parent="3.5.1.3 True">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to exposing falsehood--to do something to show that someone has told a lie.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Expose falsehood</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.3.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="51d9d243-35cc-4a1e-bcdd-f2749975f5fd"
			id="3.5.1.3.5 Real"
			parent="3.5.1.3 True">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate if something is real.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Real</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.3.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ab8ca07c-b23c-43dc-b705-7fe34ddf6d4d"
			id="3.5.1.3.6 Exaggerate"
			parent="3.5.1.3 True">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to exaggerating--reporting information but saying something untrue that makes the information seem bigger or more important than it really is.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Exaggerate</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.3.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ec1bcace-fc10-45df-8e1f-29bce1ef786a"
			id="3.5.1.4 Speak with others"
			parent="3.5.1 Say">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to carrying on a conversation with other people.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Speak with others</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="14a32765-81b0-411e-89fa-91e092a70818"
			id="3.5.1.4.1 Call"
			parent="3.5.1.4 Speak with others">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to calling someone--to say something loud because you want someone who is far away to listen to you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Call</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e033ca92-ee8c-4ab9-9368-5f6f4e942987"
			id="3.5.1.4.2 Contact"
			parent="3.5.1.4 Speak with others">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to contacting someone--to communicate with someone who is far away from you using some communication device such as a telephone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Contact</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="52b04e15-7062-4fb2-9eaa-4fe8726f302a"
			id="3.5.1.4.3 Greet"
			parent="3.5.1.4 Speak with others">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to greeting someone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Greet</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a9625460-7162-447c-b400-84fbc5744f1b"
			id="3.5.1.4.4 Say farewell"
			parent="3.5.1.4 Speak with others">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to saying farewell.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Say farewell</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.4.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="45b9bf61-3138-4206-9478-b4d3f082358b"
			id="3.5.1.4.5 Speak in unison"
			parent="3.5.1.4 Speak with others">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to speaking in unison--to say something at the same time as someone else.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Speak in unison</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.4.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="77b4d6c1-87bf-4839-b4be-6a45119b700a"
			id="3.5.1.5 Ask"
			parent="3.5.1 Say">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to asking a question.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Ask</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5fdf3946-7e47-4fd2-906f-4da7ce5fa490"
			id="3.5.1.5.1 Answer"
			parent="3.5.1.5 Ask">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to answering a question.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Answer</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a30e0391-ea64-4938-9eca-023c351d60af"
			id="3.5.1.5.2 Disclose"
			parent="3.5.1.5 Ask">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that refer to discovering and revealing unknown information.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Disclose</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="16dbd62c-f60d-4530-ba4e-0e74221e4681"
			id="3.5.1.5.3 Hide your thoughts"
			parent="3.5.1.5 Ask">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to hiding your thoughts.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Hide your thoughts</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.5.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="eafdea8e-521e-4614-8fd5-e8446adf9203"
			id="3.5.1.6 Debate"
			parent="3.5.1 Say">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to debating--for two or more people to discuss some issue and try to persuade the other person to accept one's view.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Debate</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ebac5ec8-dc4c-4b2b-a727-3ca82404cdbb"
			id="3.5.1.6.1 Demonstrate"
			parent="3.5.1.6 Debate">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to demonstrating something--to do something that shows the truth of a statement, or shows how to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Demonstrate</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e5020b79-6fb0-4be4-a359-d4f899da5c7e"
			id="3.5.1.6.2 Quarrel"
			parent="3.5.1.6 Debate">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to quarreling--to fight with words.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Quarrel</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a4958dd9-03cc-4863-ab76-cd0682060cb0"
			id="3.5.1.7 Praise"
			parent="3.5.1 Say">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to praising someone or something--to say something good about someone, or to say that someone did something good.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Praise</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="27048124-c204-4585-9997-c51728f085d6"
			id="3.5.1.7.1 Thank"
			parent="3.5.1.7 Praise">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to thanking someone--to tell someone that you feel good about something they did for you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Thank</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.7.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="53d34f16-2f94-4afa-9530-7ac75e05b8d4"
			id="3.5.1.7.2 Flatter"
			parent="3.5.1.7 Praise">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to flattering someone--saying something nice to someone but not meaning it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Flatter</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.7.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="80415fac-b3d8-4e3c-bdb8-dc92f3c6dad8"
			id="3.5.1.7.3 Boast"
			parent="3.5.1.7 Praise">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to boasting--to say something good about yourself, especially to make it seem that you are better than you really are.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Boast</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.7.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="bc9d763c-e4fe-48ab-ad44-87a36f6cc06f"
			id="3.5.1.8 Criticize"
			parent="3.5.1 Say">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to criticizing someone or something--to say that something is bad, especially something that someone did.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Criticize</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c79d49f1-74ec-4dba-a5aa-5e861af63d05"
			id="3.5.1.8.1 Blame"
			parent="3.5.1.8 Criticize">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to blaming someone for something--to say that someone did something, and because of this something bad happened.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Blame</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.8.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="81b62078-984c-4e82-94c4-39fa44dd3e56"
			id="3.5.1.8.2 Insult"
			parent="3.5.1.8 Criticize">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to insulting someone--to say that someone is bad.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Insult</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.8.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e2d3294b-4463-48bb-95e4-8c9b5238ecec"
			id="3.5.1.8.3 Mock"
			parent="3.5.1.8 Criticize">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to mocking someone--doing or saying something to make people laugh at someone because you don't like them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mock</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.8.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7bca1201-31f8-4f65-8da9-af0eff36b388"
			id="3.5.1.8.4 Gossip"
			parent="3.5.1.8 Criticize">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to gossip--to say something bad about a person who is not with you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Gossip</text>
				</form>
			</label>
