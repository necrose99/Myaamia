					lang="en">
					<text>Use this domain for words describing a person who acts in an altruistic, selfless manner--to act out of concern for the welfare of others without concern for your own welfare.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Altruistic, selfless</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5dcf3ce8-aa00-4478-b00e-691549fa29e8"
