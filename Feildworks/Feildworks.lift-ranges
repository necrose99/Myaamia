			parent="8.4.5.1 Order, sequence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to alternating--when several things happen one after another in a repeated pattern.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
