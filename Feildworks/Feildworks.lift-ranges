		<range-element
			guid="86ff66f6-0774-407a-a0dc-3eeaf873daf7"
			id="Verb">
			<description>
				<form
					lang="en">
					<text>A verb is a part of speech whose members typically signal events and actions; constitute, singly or in a phrase, a minimal predicate in a clause; govern the number and types of other constituents which may occur in the clause; and, in inflectional languages, may be inflected for tense, aspect, voice, modality, or agreement with other constituents in person, number, or grammatical gender.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Verb</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>v</text>
				</form>
			</abbrev>
			<trait
				name="catalog-source-id"
				value="Verb" />
		</range-element>
	</range>
