			guid="6fe11b6a-8d01-4a0b-bdeb-e4e6f420340a"
			id="3.1.1 Personality"
			parent="3.1 Soul, spirit">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe a person's personality (the way he usually thinks, talks, and how he acts with other people).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Personality</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.1.1</text>
				</form>
			</abbrev>
		</range-element>
