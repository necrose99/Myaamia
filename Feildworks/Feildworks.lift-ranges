			guid="e080687b-0900-4dd0-9677-e3aaa3eae641"
			id="3.5.1.2.3 Explain"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to explaining something--to help someone to understand something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Explain</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7ad54364-ca8c-4b7c-9748-f83efb44d0ea"
			id="3.5.1.2.4 Mention"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to mentioning something--to talk about something but without saying much about it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mention</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="67d282f8-151d-429b-8183-6a7d2f5ac98d"
			id="3.5.1.2.5 Introduce"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to introducing a new subject--to start talking or writing about something new for the first time.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Introduce</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.2.5</text>
