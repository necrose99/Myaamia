		<range-element
			guid="3ea52505-aa6c-4f28-b475-f15ac1820ec1"
			id="4.9.4.2 Demon possession"
			parent="4.9.4 Miracle, supernatural power">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to demon possession--when a demon or spirit influences or controls the behavior of a person. Use this domain for all words related to the relationship between spirits and people, including communication between people and spirits. Also use this domain for words referring to casting out demons--causing a demon to stop influencing or controlling a person.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Demon possession</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.9.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="38d1a6fe-0811-4eb0-a1d8-f69b6ad978e0"
