			guid="acf5e294-d169-45c1-a9d3-960536e018cc"
			id="2.3.2.2 Sound"
			parent="2.3.2 Hear">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to sounds.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sound</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fd33670e-ef16-4566-a62e-aa077e58407b"
			id="2.3.2.3 Types of sounds"
			parent="2.3.2 Hear">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to types of sounds.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Types of sounds</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6804db44-b71b-4452-98b1-b726bc7cf022"
			id="2.3.2.4 Loud"
			parent="2.3.2 Hear">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe loud sounds.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Loud</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d853597b-f3ed-470b-b6dd-8fe93b8e43eb"
			id="2.3.2.5 Quiet"
			parent="2.3.2 Hear">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe quiet sounds.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Quiet</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.3.2.5</text>
				</form>
