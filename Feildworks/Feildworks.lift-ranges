			<abbrev>
				<form
					lang="en">
					<text>9.2.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b34dc5c9-3367-4bfc-b077-cd014250dc5c"
			id="9.2.7 Interjections"
			parent="9.2 Part of speech">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all interjections.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Interjections</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8206415e-a915-4842-a46a-fbea64f1a0e3"
			id="9.2.8 Ideophones"
			parent="9.2 Part of speech">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all ideophones. If there are many ideophones in your language, it is probably not worth the trouble to list them here. Dictionary programs can sort your dictionary by part of speech, if needed.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Ideophones</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="35624f3a-2029-43b3-b70a-83e63ac9052f"
			id="9.2.9 Affixes"
			parent="9.2 Part of speech">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all affixes that do not fit in any of the subdomains under it. This section should be filled out by a linguist.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Affixes</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0049664f-0931-487b-ab3c-ce11e134ce7a"
			id="9.2.9.1 Verb affixes"
			parent="9.2.9 Affixes">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all verb affixes.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Verb affixes</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.9.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a4f4943f-ad94-4736-bf5d-f8a3cb15919f"
			id="9.2.9.2 Noun affixes"
			parent="9.2.9 Affixes">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all noun affixes.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Noun affixes</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.9.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="751f726b-b7cd-470e-a9fd-f2f1b460dd0d"
			id="9.2.9.3 Derivational affixes"
			parent="9.2.9 Affixes">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all derivational affixes. A derivational affix is joined to a root and changes it into a different word. Derivational affixes often change the root into a different part of speech. Adding a derivational affix usually changes the meaning of the root in a significant way.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Derivational affixes</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.9.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5422d4ba-8af4-4767-912e-43b60ef28eab"
			id="9.3 Very"
			parent="9 Grammar">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that intensify an attribute.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Very</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="aaf9d375-f0a0-4c7b-bbf8-3c7ffd4f5a52"
			id="9.3.1 Degree"
			parent="9.3 Very">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate a degree on a scale.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Degree</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7f91aa6d-f342-4fb9-9448-69d694cda9c5"
			id="9.3.1.1 To a large degree"
			parent="9.3.1 Degree">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a large degree.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>To a large degree</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1082c52b-490a-4eec-acf1-7016796dafd9"
			id="9.3.1.2 To a small degree"
			parent="9.3.1 Degree">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a small degree.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>To a small degree</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="73b959ab-0229-4710-af99-dfc9b5370540"
			id="9.3.1.3 To a larger degree"
			parent="9.3.1 Degree">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a larger degree.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>To a larger degree</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="984dc2b7-6fdd-4257-abdc-5873abb7bb70"
			id="9.3.1.4 To a smaller degree"
			parent="9.3.1 Degree">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a smaller degree.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>To a smaller degree</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e1dd83dd-955a-4bc7-a761-fc91555da1f8"
			id="9.3.2 Completely"
			parent="9.3 Very">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a complete degree--when something is done, happens, is thought, is felt, etc completely and in every way.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Completely</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d74914e7-e329-49d4-8513-ec8d850241e4"
			id="9.3.3 Partly"
			parent="9.3 Very">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a complete degree--when something is done, happens, is thought, is felt, etc completely and in every way.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Partly</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a22d5c1c-daed-4e7a-8243-493f2d841314"
			id="9.3.4 Do intensely"
			parent="9.3 Very">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating intensity of an action.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Do intensely</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c7c3aa7d-a4b5-45af-9a31-a640179e8fa4"
			id="9.3.5 Attribution of an attribute"
			parent="9.3 Very">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that modify an attribute.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Attribution of an attribute</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.3.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="61a28bdc-c05c-49d8-b47e-d54a9082156c"
			id="9.4 Semantic constituents related to verbs"
			parent="9 Grammar">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that modify verbs.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Semantic constituents related to verbs</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="793993ac-20c1-49f0-9716-e4cdc7da4439"
			id="9.4.1 Tense and aspect"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate tense and aspect.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tense and aspect</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="df2ee830-0668-43d7-8a32-e2fd3e7b31d8"
			id="9.4.1.1 Tense"
			parent="9.4.1 Tense and aspect">
			<description>
				<form
					lang="en">
					<text>Use this domain for verbal auxiliaries, affixes, adverbs, and particles that indicate tense (also known as temporal deixis)--the time of a situation (event, activity, or state) in relation to a reference point, which is usually the time of utterance. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tense</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ccbbd16f-58c5-45c1-bfff-1fba64d9740e"
			id="9.4.1.2 Aspect--dynamic verbs"
			parent="9.4.1 Tense and aspect">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate aspects of dynamic verbs. Aspects describe the temporal contours of a situation. They may be combined with any of the tenses, either in the same morpheme or in combinations of morphemes. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Aspect--dynamic verbs</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="321d0a74-705f-40bf-8d24-809f65bee895"
			id="9.4.1.3 Aspect--stative verbs"
			parent="9.4.1 Tense and aspect">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate aspects of stative verbs. Aspects describe the temporal contours of a situation. They may be combined with any of the tenses, either in the same morpheme or in combinations of morphemes. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Aspect--stative verbs</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="54f59b23-a2e8-4bfc-9da2-7dd7c37d2a47"
			id="9.4.1.4 Relational tenses"
			parent="9.4.1 Tense and aspect">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate relational tenses. Relational tenses describe situations where the reference time is not the same as the moment of speech. They may be combined with any of the tenses, either in the same morpheme or in combinations of morphemes. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Relational tenses</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7bf05f4e-909f-40ca-b742-9be21eba9fbb"
			id="9.4.2 Agent-oriented modalities"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate agent-oriented modalities. Agent-oriented modalities describe internal or external conditions on a willful agent with respect to the completion of the predicate situation. They may be combined with any of the tenses, either in the same morpheme or in combinations of morphemes. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Agent-oriented modalities</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="59d936f3-dffb-4585-80e0-eaf6cd6a8026"
			id="9.4.2.1 Can"
			parent="9.4.2 Agent-oriented modalities">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that someone can do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Can</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ab8d8dc9-eeb7-41ff-93a9-cbbd50b89a73"
			id="9.4.2.2 Can't"
			parent="9.4.2 Agent-oriented modalities">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being incapable of doing something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Can't</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="47feee3e-80e1-469a-911c-0c550b37a2f8"
			id="9.4.2.3 Necessary"
			parent="9.4.2 Agent-oriented modalities">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses to indicate that he thinks something must happen.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Necessary</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c3ddfc77-e3a6-450e-a853-111f5595df87"
			id="9.4.3 Moods"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate moods.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Moods</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="965c6a0b-3034-4e2f-a00b-ed2eb3119a5d"
			id="9.4.3.1 Imperative"
			parent="9.4.3 Moods">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate imperatives. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press. Use this domain for words and affixes that a speaker uses to indicate that he is making a command. English has no command word. Some languages change the form of the verb by adding an affix. Some languages have special verbs that are only or normally used as commands. Those verbs could be classified here.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Imperative</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="edeb9458-3bdb-4d14-aaa1-6eb457307b9c"
			id="9.4.3.2 Hortative"
			parent="9.4.3 Moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for ways of saying that someone should do something. If I say someone should do something, I think it is good that he does it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Hortative</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6fa33de6-00f4-44d5-b6b3-b3c4a4f671e5"
			id="9.4.3.3 Interrogative"
			parent="9.4.3 Moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses to indicate that he is asking a question. English has no question word, but other languages such as Japanese do.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Interrogative</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3ea4c495-b837-4310-8741-38d89fa63e0b"
			id="9.4.4 Epistemic moods"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate epistemic moods. Epistemic moods have the whole proposition in their scope and indicate the degree of commitment of the speaker to the truth or future truth of the proposition. They may be combined with any of the tenses, either in the same morpheme or in combinations of morphemes. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Epistemic moods</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ad7cc381-1dc6-4fc2-94a4-acd5bf7a11da"
			id="9.4.4.1 Certainly, definitely"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses to indicate that he thinks something is certainly true or is certain to happen.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Certainly, definitely</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="af6fe2d6-576d-473f-8a32-583779d95d1d"
			id="9.4.4.2 Sure"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being sure that something is true.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sure</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="84eb31d3-b932-4b3b-b945-85884ea856c7"
			id="9.4.4.3 Probably"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses to indicate that he thinks something is probable or likely to occur.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Probably</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="85c5b8f7-8086-493d-b70d-a361bfa56f09"
			id="9.4.4.4 Possible"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses to indicate that he thinks something is possible. Maybe implies that the speaker doesn't know something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Possible</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e0c32642-7c51-4e23-a776-f63f2f2f936d"
			id="9.4.4.5 Uncertain"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate that no one is certain that something is true, or when it is impossible to be certain that something is true.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Uncertain</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1a635032-6e13-4a56-aa03-6c6a015c502e"
			id="9.4.4.6 Unsure"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to not feeling sure about something or someone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Unsure</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="13e67cc9-055b-4f9b-9217-a16b18db0329"
			id="9.4.4.6.1 Think so"
			parent="9.4.4.6 Unsure">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that you think something is true, but you are not completely sure about it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Think so</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e0b00a13-8648-4635-afe5-0be3c0b6a05c"
			id="9.4.4.6.2 Maybe"
			parent="9.4.4.6 Unsure">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses to indicate that he thinks it is possible that something may happen or be true, but he isn't certain.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Maybe</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="858af232-b570-4153-b4c0-f60930df9ced"
			id="9.4.4.6.3 Seem"
			parent="9.4.4.6 Unsure">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something seems to be a certain way--you see (or hear) something and think something about it, but you are not sure that what you think is true.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Seem</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.6.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7c022751-a9f9-412d-8b27-8cd03b797e2d"
			id="9.4.4.7 Just, almost not"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that although something is true, it almost is not true.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Just, almost not</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ca495e57-a8e0-4294-bfe3-7b7995dc96c7"
			id="9.4.4.8 Don't think so, doubt it"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that you think something is unlikely to be true or to happen.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Don't think so, doubt it</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f883266a-146a-41c7-b1db-85120840c3a8"
			id="9.4.4.9 Impossible"
			parent="9.4.4 Epistemic moods">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses to indicate that he thinks something is impossible.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Impossible</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.4.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="04752883-aa3e-42a2-bd42-454e9cd99b11"
			id="9.4.5 Evidentials"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate evidentials. An evidential is when the speaker indicates the source of the information on which an assertion about a situation is based. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Evidentials</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cf5f83be-2c19-4cf8-8cc5-53bd32b50530"
			id="9.4.5.1 Evaluator"
			parent="9.4.5 Evidentials">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating who is evaluating the proposition.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Evaluator</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a03663ca-0c66-4570-be2d-b40105cc4400"
			id="9.4.6 Yes"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that affirm or agree with the truth of something, or that answer a yes/no question in the affirmative.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Yes</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="350667ee-592b-47af-adca-14e820ec58cf"
			id="9.4.6.1 No, not"
			parent="9.4.6 Yes">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that negate or deny the truth of something, or that answer a yes/no question in the negative.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>No, not</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b4c1e05f-f741-45cc-8d13-a1f60f474325"
			id="9.4.6.2 Markers expecting an affirmative answer"
			parent="9.4.6 Yes">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that an affirmative answer is expected to a question.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Markers expecting an affirmative answer</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e64e647e-a5fb-463c-8eef-44879e2e70b2"
			id="9.4.6.3 Markers expecting a negative answer"
			parent="9.4.6 Yes">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that a negative answer is expected to a question.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Markers expecting a negative answer</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.6.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1de2cef5-3a2d-45c1-8cb6-06b2ac087907"
			id="9.4.7 Subordinating particles"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate a subordinate clause. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Subordinating particles</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fa8e72a0-1bfe-4b49-a287-293b44213960"
			id="9.4.8 Adverbial clauses"
			parent="9.4 Semantic constituents related to verbs">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate adverbial clauses. The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Adverbial clauses</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.4.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="aab82dc7-de9f-44b3-845e-0c926f47cfb6"
			id="9.5 Case"
			parent="9 Grammar">
			<description>
				<form
					lang="en">
					<text>Each verb has a set of semantic case relations. For instance in the sentence 'I gave flowers to my wife' the verb give has three case relations. 'I' is the Agent, 'flowers' is the Patient, and 'my wife is the 'Recipient'. In this sentence the only word that marks a case relation is 'to'. English often marks case relations by their position in the sentence. Some languages mark case relations by affixes, prepositions, postpositions, and sometimes special verbs. To completely describe a language, each verb must be investigated, all its case relations must be identified, and all the ways in which these relations are marked must be described. Since verbs are often unique and unpredictable in their case relations, this information should go into the dictionary. This section should be used to classify the words and affixes that are used to mark case relations. This domain should be used for technical terms that refer to case.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Case</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="bb8ddf5f-707d-46c0-aff4-45683d26fd68"
			id="9.5.1 Primary cases"
			parent="9.5 Case">
			<description>
				<form
					lang="en">
					<text>Use this section for primary cases.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Primary cases</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="93df663c-9a5e-48aa-984f-fdf413079bc2"
			id="9.5.1.1 Beneficiary of an event"
			parent="9.5.1 Primary cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that mark the beneficiary of an event. The sentence "John built a house for his father" is ambiguous. If the house was for his father to live in, then "for" would mark the 'Beneficiary of a patient', meaning that the house was for the father. If, on the other hand, the father was intending to build the house to sell, but couldn't due to an injury, then "for" would mark the 'Beneficiary of an event', meaning the father benefited from the building of the house.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Beneficiary of an event</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="4415aff1-4d74-463e-a25d-9832c7477329"
			id="9.5.1.2 Instrument"
			parent="9.5.1 Primary cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that mark an instrument used to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Instrument</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="4f587b2b-60a6-4ea0-9fe5-89e5a502d380"
			id="9.5.1.3 Means"
			parent="9.5.1 Primary cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating the means by which something is done.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Means</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d0b14231-1471-41b3-aeb5-69199acaaefb"
			id="9.5.1.4 Way, manner"
			parent="9.5.1 Primary cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating the way or manner in which something is done.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Way, manner</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="aabc32ee-46e4-469f-93ad-673373cb2e8d"
			id="9.5.1.5 Attendant circumstances"
			parent="9.5.1 Primary cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating the attendant circumstances in which something happened.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Attendant circumstances</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="71757ff0-d698-426d-a791-50c4bde6f735"
			id="9.5.1.6 Spatial location of an event"
			parent="9.5.1 Primary cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating the spatial location of an event.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Spatial location of an event</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="400d318e-a9ef-40b4-92be-0d7e96e51d8a"
			id="9.5.1.6.1 Source (of movement)"
			parent="9.5.1.6 Spatial location of an event">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that mark the Source (original location) of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Source (of movement)</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a9470e53-ee43-4c87-9cce-09cc4fa6b1c1"
			id="9.5.1.6.2 Path (of movement)"
			parent="9.5.1.6 Spatial location of an event">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating the Path of movement.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Path (of movement)</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9f91cd53-8b9e-4d76-82e4-5ede39112322"
			id="9.5.1.6.3 Goal (of movement)"
			parent="9.5.1.6 Spatial location of an event">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating the Goal of movement.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Goal (of movement)</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.6.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="66e2806d-3e16-4fb2-a158-7f3b4dd5d9af"
			id="9.5.1.6.4 Origin (of a person)"
			parent="9.5.1.6 Spatial location of an event">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that mark the place where someone was born or the place where they have been living.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Origin (of a person)</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.1.6.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0eefa07a-e0a3-49e3-aeb4-62f1eafd8e23"
			id="9.5.2 Semantically similar events"
			parent="9.5 Case">
			<description>
				<form
					lang="en">
					<text>Use this section for words that join semantically similar events into one sentence. Each sentence is actually reporting two or more situations, which may differ in one or two respects. The words to be included in these domains indicate that two situations are being reported, or mark the differences between the two situations.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Semantically similar events</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="42b21a6e-e2f3-4468-9e92-49ee4de6909a"
			id="9.5.2.1 Together"
			parent="9.5.2 Semantically similar events">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating when two or more people each do the same thing and do it together, or when they do it separately.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Together</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3a545732-145a-4034-8f72-e08d752cb4d4"
			id="9.5.2.2 With, be with"
			parent="9.5.2 Semantically similar events">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating a person who accompanied the subject of a proposition.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>With, be with</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6903b844-79be-4e9d-a3c8-1ca2a385bf4f"
			id="9.5.2.3 With, do with someone"
			parent="9.5.2 Semantically similar events">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating a person who does something with another person who is the subject of the sentence.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>With, do with someone</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d39b2432-87d5-4f3e-8101-de06001b42d6"
			id="9.5.2.4 Each other"
			parent="9.5.2 Semantically similar events">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that two or more people do something to each other.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Each other</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="52f9a8f0-d97d-4aa1-8c2c-d907d7cb83fc"
			id="9.5.2.5 In groups"
			parent="9.5.2 Semantically similar events">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that the subjects of a clause do something in groups.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>In groups</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="116bef13-e80f-4a15-bb0a-bb7b3794ffac"
			id="9.5.3 Patient-related cases"
			parent="9.5 Case">
			<description>
				<form
					lang="en">
					<text>Use this section for cases that bear a relationship to the 'Patient' of a proposition.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Patient-related cases</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ca0f9b9b-31fc-4ae6-9563-abedc4a5af98"
			id="9.5.3.1 Beneficiary (of a patient)"
			parent="9.5.3 Patient-related cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that mark the beneficiary of the Patient of an activity. The Patient is often expressed as the object of a sentence. In the sentence "John built a house for his parents," the house is the Patient. It is the house that benefits the parents, not the building of the house.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Beneficiary (of a patient)</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="99c51a2c-ad49-48a6-bb0b-f059da745ec4"
			id="9.5.3.2 Recipient (of a patient)"
			parent="9.5.3 Patient-related cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that mark the recipient of the Patient of an activity. The Patient is usually expressed as the object of a sentence.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Recipient (of a patient)</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="55b93f1c-6ce0-4d13-ae1e-f06360e4689c"
			id="9.5.3.3 With (a patient)"
			parent="9.5.3 Patient-related cases">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that mark a second Patient that accompanies the primary Patient of an activity. In this type of sentence there are actually two Patients, but one of them has more prominence than the other. The primary patient is usually expressed as the object of the sentence. The second Patient may be marked by an oblique case or preposition/postposition. For instance it may be conceived as accompanying the first Patient.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>With (a patient)</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.5.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7f7fc197-5064-43c0-af51-2919fb7355c9"
			id="9.6 Connected with, related"
			parent="9 Grammar">
			<description>
				<form
					lang="en">
					<text>Use the domains in this section for words that indicate a logical relation between two or more words or sentences. Use this domain for words that indicate an unspecified logical relation between people, things, or situations.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Connected with, related</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="265f5645-94cb-485c-8bf9-0a3ab2354f63"
			id="9.6.1 Coordinate relations"
			parent="9.6 Connected with, related">
			<description>
				<form
					lang="en">
					<text>Use this section for words indicating coordinate relations. Do not put any words in this domain. It is only for organizational purposes.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Coordinate relations</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c029eed8-2ec0-4f6f-aa22-3a066bb23ea6"
			id="9.6.1.1 And, also"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate that you are adding another thought to a previous thought. Words in this domain may indicate a variety of relationships between words, phrases, clauses, or sentences. For instance the words may join two clauses that are the same except that the subjects are different, or the objects are different, or the verbs are different.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>And, also</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8b5f9519-7301-4400-b93d-ebde4ea3def8"
			id="9.6.1.2 Or, either"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating an alternative relation between two things or propositions.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Or, either</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="13edbeff-8913-49ef-8f02-777f86fb512d"
			id="9.6.1.3 Association"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating an association between two things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Association</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ecf1cce7-ed58-44bf-870a-e8579b309c54"
			id="9.6.1.4 Combinative relation"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating a combinative relation between two things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Combinative relation</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="30fff450-1aa5-4993-9c14-c8019a5f072e"
			id="9.6.1.5 But"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating a contrast between two thoughts that are different in some way.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>But</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="49f45f97-95f8-4a53-8952-f90147af2ba9"
			id="9.6.1.5.1 Except"
			parent="9.6.1.5 But">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something is an exception to a group, rule or pattern--something is true of all the things (or people) in a group, but it is not true of one thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Except</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f94e9041-49b0-4d25-aa54-9446c5ab45f4"
			id="9.6.1.5.2 Instead"
			parent="9.6.1.5 But">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something is true of one thing (or person) instead of another thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Instead</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d8dfa6fc-84ea-4178-b4f5-95e0c113140a"
			id="9.6.1.6 Dissociation"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating a dissociation relation between two things or propositions.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Dissociation</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ea7c06d0-5e33-4702-b6a0-51582b216fe8"
			id="9.6.1.7 Distribution"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that an event is distributed throughout a group, area, or time span.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Distribution</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="251b17bd-5796-43ce-ba10-54140a99a1e0"
			id="9.6.1.8 Equivalence"
			parent="9.6.1 Coordinate relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating equivalence between two things or propositions.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Equivalence</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.1.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b2fd2d29-1389-4114-91a8-15b8d9742794"
			id="9.6.2 Dependency relations"
			parent="9.6 Connected with, related">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something is dependent on another thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Dependency relations</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="66dedb31-dd2a-4e94-825e-331590ac59a9"
			id="9.6.2.1 Derivation"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something derives from another thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Derivation</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="05e20a72-9496-4bba-8097-5605692e83a1"
			id="9.6.2.2 Limitation of topic"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating the topic that is being talked about.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Limitation of topic</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1b4f987d-3eaa-46dd-95ee-e0cb1f30cfbb"
			id="9.6.2.2.1 In general"
			parent="9.6.2.2 Limitation of topic">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something is generally true, but not true in every case.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>In general</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3759bdda-2b52-43dc-8995-8379e3129dce"
			id="9.6.2.3 Relations involving correspondences"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating relations involving correspondences--a situation in which one thing is the same or similar in some respect to something else.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Relations involving correspondences</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="779e4547-dee6-4780-a180-30a740f9574c"
			id="9.6.2.4 Basis"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something is the basis for another thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Basis</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="23bc906d-c15a-4368-b0ca-7443d5e37b83"
			id="9.6.2.5 Cause"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate that someone or something is the cause for an event or state, that one event is the cause for another event or state, or that an event or state is reasonable (having sufficient cause). For instance in the sentence, "John caused David to fall," "John caused" is an enabling proposition that brings about the primary proposition "David fell."</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Cause</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e173ea34-c216-4702-aa24-ca9ab40d48dd"
			id="9.6.2.5.1 Reason"
			parent="9.6.2.5 Cause">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that reason why someone does something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Reason</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="be3559d9-d69f-4e06-8184-071c35aa2e10"
			id="9.6.2.5.2 Without cause"
			parent="9.6.2.5 Cause">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate that an event or state has no cause or reason, or is unreasonable (has insufficient cause).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Without cause</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="48d3de9f-3619-4785-b50b-6921ba7eecd6"
			id="9.6.2.6 Result"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something is the result of another thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Result</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="139409c3-7860-4586-897f-85ba3226046c"
			id="9.6.2.6.1 Without result"
			parent="9.6.2.6 Result">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something had no result.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Without result</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="18bf6c79-6399-4977-be3d-93135302d8c4"
			id="9.6.2.7 Purpose"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something was done for the purpose of another thing happening.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Purpose</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="4fdf3cf1-0808-4f11-acdd-9db71550baab"
			id="9.6.2.7.1 Without purpose"
			parent="9.6.2.7 Purpose">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something had no purpose.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Without purpose</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.7.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f858278a-2727-4403-9cf0-565cdececb1e"
			id="9.6.2.8 Condition"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this section for verbal auxiliaries, affixes, adverbs, and particles that indicate a clause in a conditional sentence (If this is true, then that is true). The following definitions are taken from Bybee, Joan, Revere Perkins, and William Pagliuca. 1994. The evolution of grammar. Chicago and London: University of Chicago Press.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Condition</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2f28f1ab-476e-4317-8787-124d95d6b9d2"
			id="9.6.2.9 Concession"
			parent="9.6.2 Dependency relations">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that the speaker is conceding a point in a debate.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Concession</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.2.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f02ae505-d6b7-4b30-9d97-8505d0d1a0c7"
			id="9.6.3 Discourse markers"
			parent="9.6 Connected with, related">
			<description>
				<form
					lang="en">
					<text>Use this domain for conjunctions and particles that function on the discourse level, and whose meaning and function is uncertain.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Discourse markers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="638679c7-1c7c-41da-ab60-0ac7e98fcd72"
			id="9.6.3.1 Markers of transition"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for conjunctions that simply move the discourse forward without any specific relationship indicated between what comes before and what comes after.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Markers of transition</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7c1c3730-3b35-4150-b54e-bf6d344546b3"
			id="9.6.3.2 Markers of emphasis"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate that the phrase or sentence is particularly important.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Markers of emphasis</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c103d339-24f2-45c6-8539-d3c445e15c49"
			id="9.6.3.3 Prompters of attention"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that are used to get someone's attention or direct the listener's attention to something. These may use a verb meaning 'look' or 'listen'. Some may be a word specifically referring to attention. Others may be a greeting. Others may be words that refer to non-verbal communication such as clearing your throat.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Prompters of attention</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="577a9f51-263a-4c80-a439-84ce45b9c7cc"
			id="9.6.3.4 Markers of direct address"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that the speaker uses to refer to the person he is addressing. These words are usually used when you start talking to someone, but can be used during a speech or conversation to refer to the person you are talking to.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Markers of direct address</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fbf40f2e-e743-479d-80b2-63325407d5d1"
			id="9.6.3.5 Markers of identificational and explanatory clauses"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that begin a clause that identifies a specific case or example of what has just been said, or that explains what has just been said. Specific case: I have just mentioned a general class of things or a general idea and want to give a specific example of what I am talking about. Explanation: I have just said something and I think people might misunderstand, so I want to explain what I mean. Digression: I am talking about a particular topic, but want to say something that does not fit into my topic, so I say something that is about a different topic.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Markers of identificational and explanatory clauses</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="15e0b54b-bb7c-4900-b048-20b718d05f79"
			id="9.6.3.6 Markers of focus"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that one of several things is in focus.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Markers of focus</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="41837400-bdc5-4cbc-a1dc-d793f713f883"
			id="9.6.3.7 Hesitation fillers"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that a speaker uses when he hesitates or pauses while he is speaking in order to think about what he is saying.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Hesitation fillers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2e5a80f9-35ae-4850-9627-be530832a781"
			id="9.6.3.8 Honorifics"
			parent="9.6.3 Discourse markers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that the speaker uses to show respect or a lack of respect to the person he is addressing. Some languages have elaborate systems of honorifics. Other languages have none. Languages with a stratified social structure often use honorifics. Egalitarian societies generally lack them, but some egalitarian societies may use them. For instance in Nahuatl there are four levels of honorifics. Level 1 is how one addresses intimates, small children, and pets. Level 2 is for strangers and persons treated formally. Level 3 is for respected persons, the dead, and God. Level 4 is for obsequious respect, as for the archbishop in an interview with a priest, and for ritual kin. (Jane H. Hill and Kenneth C. Hill. 1978. Honorific usage in modern Nahuatl: the expression of social distance and respect in the Nahuatl of the Malinche Volcano area, Language 54:123-155.) In Japanese, which has a stratified social structure, a person uses one set of words and affixes when speaking to someone below you in the social hierarchy, such as your wife, children, and pets. A different set of words is used when speaking to peers. Another set is used when speaking to a superior. A fourth set is used when speaking to the emperor. English used to have two pronouns for second person singular. 'Thou' was used for equals and inferiors, and 'you' was used for superiors. Your language may have special honorific words used as (1) pronouns, (2) affixes, (3) particles, (4) terms of direct address, (5) greetings (6) requests, (7) apologies.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Honorifics</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.6.3.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5b7666bd-c6c1-45e7-aa2e-1799fcb16d97"
			id="9.7 Name"
			parent="9 Grammar">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words referring to proper nouns--the name given to a particular person or thing to distinguish it from other things like it. Proper nouns are often not included in a dictionary, or are included in an appendix at the front or back of a dictionary. This is because there are so many of them, they are sometimes difficult to define, and it saves space in the dictionary. For instance place names can be included in a map. So it might be good to type the proper nouns into a special file.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Name</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7b513a02-c3ae-4243-9410-16854d911258"
			id="9.7.1 Name of a person"
			parent="9.7 Name">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the name of a person. Each culture has a system of personal names to identify individuals and kin groups. The subcategories under this heading should reflect the cultural system. If your language has a special set of names that do not fit any of they domains given here, then set up a special domain.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Name of a person</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6b921117-47e9-4717-b3b3-4e170d26b6d9"
			id="9.7.1.1 Personal names"
			parent="9.7.1 Name of a person">
			<description>
				<form
					lang="en">
					<text>Use this domain for those names that are given to people, that people use to call to each other and to talk about each other.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Personal names</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c2ec9cee-7fe3-44f2-9008-c8b42f6f78dd"
			id="9.7.1.2 Family names"
			parent="9.7.1 Name of a person">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the families that exist within the language community. If your culture does not use family names, just leave this domain empty.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Family names</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="774cdff1-8cba-4f94-a519-c66abd3b5f49"
			id="9.7.1.3 Clan names"
			parent="9.7.1 Name of a person">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the clans that exist within the language community. The distinction between family, clan, tribe, and nation is based on politics and emotion. Our purpose here is not to make political statements, but merely to list the names. There may be no distinction between family and clan, in which case ignore this domain and use the domain 'Family names'.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Clan names</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5771f3a1-fda3-4111-9abc-7a0d76c60a79"
			id="9.7.1.4 Tribal names"
			parent="9.7.1 Name of a person">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the tribes that exist around the language community, including the name of your own tribe. These tribal names may or may not correspond with the names of countries.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Tribal names</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="dd3e872a-fb50-4204-9646-7a24c644013b"
			id="9.7.1.5 Names of languages"
			parent="9.7.1 Name of a person">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the languages that are spoken in the area around the language community, including the name of your own language. These language names may or may not correspond with the names of countries. Do not try to include every language name in the world, only the neighboring and important ones. For instance you might want to include the languages that border your own and the national language. Give the form that you use. For instance the German people call their language 'Deutsch', but in English we call it 'German'.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of languages</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="94f573ff-29f0-42ae-b1d9-f882823b2935"
			id="9.7.1.6 Nickname"
			parent="9.7.1 Name of a person">
			<description>
				<form
					lang="en">
					<text>Use this domain for common nicknames--an additional name given to a person later in life, often descriptive. Also include general names used to call or refer to someone when you don't know their name</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Nickname</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ebb5f3e5-bfe5-4a40-986a-938c1bdb9c76"
			id="9.7.1.7 Terms of endearment"
			parent="9.7.1 Name of a person">
			<description>
				<form
					lang="en">
					<text>Use this domain for terms of endearment--a name used by lovers or spouses to express love or intimacy. Some languages may have special names used by close friends.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Terms of endearment</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="69541573-f845-4e77-91f6-1e3551fc6c82"
			id="9.7.2 Name of a place"
			parent="9.7 Name">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to the name of a place.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Name of a place</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ee0585b1-627a-4a71-888d-b5d82619431e"
			id="9.7.2.1 Names of countries"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the countries that exist around the language community, especially those countries where your language is spoken. Include the name of your own country. Do not list every country in the world, unless your language has developed special names or pronunciations for those countries. Include any country that you refer to in your language, especially those names whose pronunciation you have adapted to fit your language. Give the form of the name that you use, rather than the official spelling. For instance the Japanese refer to their country as 'Nihon', but in English will call it 'Japan'. So 'Japan' is an English word and should go into an English dictionary. But 'Nihon' is not an English word and should not go in the dictionary.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of countries</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="85cb1e3c-62ba-4a77-a838-0237707fb0cb"
			id="9.7.2.2 Names of regions"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the regions within your country or language area. Some of these may be political regions. Others may be informal terms. Give the local pronunciation, rather than some foreign spelling. You may want to limit this domain to just those areas within your language area. However if you have special names for areas outside of your language area, for example 'the Mideast', you should include them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of regions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b8e66bb4-140c-45b4-89ce-d9a77b9e5d21"
			id="9.7.2.3 Names of cities"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of cities, towns, and villages in the language area. Include the names of important cities outside of the language area if your language has a special name for the city or a different pronunciation for it. It might be good to use a map for this. In fact it is good to include a map of the language area in a published dictionary. If your language area is very large, there may be hundreds or thousands of cities, towns, and villages. In this case you will have to decide which should be included in the dictionary. Or you could decided to list them in a special section.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of cities</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="35a9da32-53ee-44fa-9c65-5a15f88ad283"
			id="9.7.2.4 Names of streets"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of highways, roads, streets, and trails in the language area. If there are many such names, only include the important names (e.g. King's Highway) or commonly used names (e.g. Main Street).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of streets</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="69d366d2-9735-4a1b-b938-7b212932b568"
			id="9.7.2.5 Names of heavenly bodies"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the heavenly bodies.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of heavenly bodies</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="09ac3709-0b0e-4046-b6b2-7869d574aa0d"
			id="9.7.2.6 Names of continents"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the continents. Only include the names of continents if your language has borrowed or adapted the name and you talk about them in your language.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of continents</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d90e71bf-2898-4501-9d09-c518999f83e2"
			id="9.7.2.7 Names of mountains"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the mountains in the language area. Only include the names of mountains outside the language area if your language has borrowed or adapted the name and you talk about them in your language.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of mountains</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a105e31c-1268-4fc2-8655-838d34860ece"
			id="9.7.2.8 Names of oceans and lakes"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the oceans and lakes in the language area. Only include the names of oceans and lakes outside the language area if your language has borrowed or adapted the name and you talk about them in your language.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of oceans and lakes</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e8ec3885-c692-4b90-a5b3-4c86da642666"
			id="9.7.2.9 Names of rivers"
			parent="9.7.2 Name of a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for the proper names of the rivers in the language area. Only include the names of rivers outside the language area if your language has borrowed or adapted the name and you talk about them in your language.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Names of rivers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.2.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7d111356-e04e-4891-960c-2f35147eba82"
			id="9.7.3 Name of a thing"
			parent="9.7 Name">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the name of a thing. Many cultures give names to particular buildings, ships, airplanes, organizations, companies, schools, and other things. If your language has hundreds of names for some kind of thing, it is best to not try to list them all. But if there are a few important names for one kind of thing, set up a domain for them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Name of a thing</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.7.3</text>
				</form>
