			guid="6bf8ce57-1970-4efb-a7d7-b0bf8be6fb6b"
			id="8.4.5.3 Right time"
			parent="8.4.5 Relative time">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to the right time to do something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Right time</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.4.5.3</text>
				</form>
