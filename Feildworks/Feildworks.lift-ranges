			</description>
			<label>
				<form
					lang="en">
					<text>Entrust to the care of</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4.5.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fe66d433-5135-498e-a29d-b42bf0317252"
			id="4.3.4.6 Meddle"
			parent="4.3.4 Do good to">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to meddling--involving oneself in something that does not concern oneself, such as someone else's business or affairs, or a fight between other people.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Meddle</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4.6</text>
				</form>
			</abbrev>
		</range-element>
