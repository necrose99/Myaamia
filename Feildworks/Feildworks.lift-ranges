		<range-element
			guid="d60faf11-cc6e-48db-8a13-82f86d78ab00"
			id="7 Physical actions">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words for physical actions--moving yourself, moving things, and changing things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Physical actions</text>
				</form>
