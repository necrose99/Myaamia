			id="8.2.2 Long"
			parent="8.2 Big">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being long. In many languages there is more than one system of measuring length. These systems may be used for different purposes or in different jobs. For instance measuring the length of an object may use different words than measuring the distance a person travels.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Long</text>
