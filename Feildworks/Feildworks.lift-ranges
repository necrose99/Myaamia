				<form
					lang="en">
					<text>4.3.4.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0f323bee-0d8a-4564-9691-87880f55d910"
			id="4.3.4.5.1 Provide for, support"
			parent="4.3.4.5 Share with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to providing someone with what they need to live each day, such as providing for an elderly parent who can no longer earn what they need.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Provide for, support</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="50e28fa7-f6c3-45bc-871d-12ef771d532c"
			id="4.3.4.5.2 Care for"
			parent="4.3.4.5 Share with">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to caring for someone--to do something good for someone, because they need something and cannot do it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Care for</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.4.5.2</text>
				</form>
			</abbrev>
