			<label>
				<form
					lang="en">
					<text>Be at a place</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8affe94d-a396-4404-a0d7-c65046e617e6"
			id="8.5.3.1 Absent"
			parent="8.5.3 Be at a place">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being absent--to not be in a particular place, or not be in the correct or expected place.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Absent</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a4b03891-c2df-4d72-bbdc-13bc8d4eceba"
			id="8.5.4 Area"
			parent="8.5 Location">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to an area.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Area</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ec6f626c-e7a0-4ec7-a541-d683f20c9271"
			id="8.5.4.1 Vicinity"
			parent="8.5.4 Area">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to a vicinity--an area around something else.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Vicinity</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="80de758c-537d-4c8c-8308-4babfb2c787a"
			id="8.5.4.2 Occupy an area"
			parent="8.5.4 Area">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to occupying an area.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Occupy an area</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f45a456e-8e23-4364-8842-047cc73f529b"
			id="8.5.4.3 Space, room"
			parent="8.5.4 Area">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to the amount of empty space that is available to be used.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Space, room</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="061749a8-e28a-461c-bf2d-052ab3e157d5"
			id="8.5.4.4 Interval, space"
			parent="8.5.4 Area">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to an interval or space between things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Interval, space</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.4.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3785d9f3-0922-4d79-a0fa-b97c4a26fe17"
			id="8.5.5 Spatial relations"
			parent="8.5 Location">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate a spatial relation between situations.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Spatial relations</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8fbed974-7d25-44c3-80cb-7d02e4069007"
			id="8.5.6 Contain"
			parent="8.5 Location">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that express the idea that something contains something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Contain</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.5.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="91913920-8a6a-4ba0-9361-d6cc9e1f3639"
			id="8.6 Parts of things"
			parent="8 States">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that refer to a part of something. These words are often based on the parts of a person's body.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Parts of things</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="bddc70ea-d46f-4e4b-83a1-a47bea858dd6"
			id="8.6.1 Front"
			parent="8.6 Parts of things">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the front part of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Front</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ed976bbe-4fb2-4365-b136-d2fce077a73f"
			id="8.6.1.1 Back"
			parent="8.6.1 Front">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the back part of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Back</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5ee64d88-c462-4505-b14a-5d36e357a024"
			id="8.6.2 Top"
			parent="8.6 Parts of things">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the top part of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Top</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="6a4f5638-388e-4c8e-9bb7-8e742dac43db"
			id="8.6.2.1 Bottom"
			parent="8.6.2 Top">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the bottom part of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Bottom</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9e775794-3dda-4942-b6af-087ffd57f342"
			id="8.6.3 Side"
			parent="8.6 Parts of things">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the side part of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Side</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="4d2a247e-4925-4750-8c39-e2d78665d33c"
			id="8.6.4 Inner part"
			parent="8.6 Parts of things">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the inside part of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Inner part</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e2806bed-b450-4469-900a-1afa7ded2224"
			id="8.6.4.1 Outer part"
			parent="8.6.4 Inner part">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the outside or surface part of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Outer part</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3005971d-de4d-401f-8400-b25de5e052ad"
			id="8.6.5 Middle"
			parent="8.6 Parts of things">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the middle part or center of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Middle</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fc170f70-520e-4f3e-b8b8-98e4b898fd24"
			id="8.6.6 Edge"
			parent="8.6 Parts of things">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the edge of something--the part of something where two sides come together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Edge</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e1e0b800-85ad-4886-abe5-9f67c022a5ed"
			id="8.6.7 End, point"
			parent="8.6 Parts of things">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the end of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>End, point</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.6.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="349f0278-7998-422a-9c3b-6053989cbb20"
			id="9 Grammar">
			<description>
				<form
					lang="en">
					<text>Use this domain for technical linguistic terms that refer to grammatical words and constructions. Most languages have few if any words in this domain.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Grammar</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="3a2c0773-6b3e-4f8b-909d-c8f84d66d4f4"
			id="9.1 General words"
			parent="9 Grammar">
			<description>
				<form
					lang="en">
					<text>Use the following section for words that don't belong in any other domain because they are so general in meaning that you can use them to talk about any topic. Use this domain for general and indefinite words that can be used in the place of any word. Some languages have a general word that can replace a noun or a verb. For instance some Philippine languages use the word 'kwan' in this way. Colloquial German can use the word 'dings' as a noun or verb. Often these words are used when you can't remember the particular word you are trying to think of. In English we use the word 'blank' when we don't want to say a word, for instance when we are testing someone and want them to say the word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>General words</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a72ca6f7-e389-408a-8276-fec4d60a3a56"
			id="9.1.1 Be"
			parent="9.1 General words">
			<description>
				<form
					lang="en">
					<text>Many languages have general words that indicate some kind of state. These general words may be used with a wide variety of specific meanings. For instance in English the word 'be' may be used to identify something, describe something, and many other ideas.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Be</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0d63adce-41dd-4873-b0bf-331d0205e65d"
			id="9.1.1.1 Exist"
			parent="9.1.1 Be">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that something exists.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Exist</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="093eeea2-4ff6-4ee8-ad05-8af1702b7246"
			id="9.1.1.2 Become, change state"
			parent="9.1.1 Be">
			<description>
				<form
					lang="en">
					<text>Many languages have general words that indicate some kind of change of state. These general words may be used with a wide variety of specific meanings. For instance in English the word 'become' may be used to a change in identity, a change in characteristic, a change in nature, and many other ideas.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Become, change state</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="da988f73-fc9d-4a23-b70d-22299a7c6097"
			id="9.1.1.3 Have, of"
			parent="9.1.1 Be">
			<description>
				<form
					lang="en">
					<text>Many languages have several general words that are used to indicate a variety of relationships between two things. There are three such words in English: "have," "of," and the possessive suffix "-'s." The basic meaning of these words in English is 'to own', but they can mean many other things too. For instance they can mean that I am related to someone (I have a brother), something has a part (birds have wings), and many other ideas. There is also a set of pronouns in English that are like nouns ending in -'s (my/mine, your/yours, his, her/hers, its, our/ours, their/theirs, whose). Use this domain for these general words.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Have, of</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="94cad4ca-c2ec-4ff3-b9b1-11107549941d"
			id="9.1.1.4 Attribution"
			parent="9.1.1 Be">
			<description>
				<form
					lang="en">
					<text>Attributes often belong to a class of attributes (shape = straight, curved) or to a scale (length = long, short). The class or scale can sometimes be included in the expression, but does not mark the proposition itself. (The towel &lt;feels&gt; damp. The box &lt;weighs&gt; five kilos.)</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Attribution</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e28f3f79-d4a5-402c-8a70-196856791078"
			id="9.1.2 Do"
			parent="9.1 General words">
			<description>
				<form
					lang="en">
					<text>Use this domain for general verbs with a volitional subject (agent).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Do</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b158fe11-5af2-4467-bbc0-cc1aee766592"
			id="9.1.2.1 Happen"
			parent="9.1.2 Do">
			<description>
				<form
					lang="en">
					<text>Use this domain for non-volitional pro-verbs.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Happen</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="12a028d1-d910-4011-ab9d-59be69daaf65"
			id="9.1.2.2 React, respond"
			parent="9.1.2 Do">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to reacting or responding to something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>React, respond</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d47b69e0-ab4a-4111-aec3-2c889a4e70b3"
			id="9.1.2.3 Create"
			parent="9.1.2 Do">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to creating something--causing something to be that did not exist before.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Create</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ecaff061-6a12-4ad6-b818-9b140a9a3e11"
			id="9.1.2.4 Design"
			parent="9.1.2 Do">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to designing something--to decide and plan how something new will look and work.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Design</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2d5d634e-75b5-4921-922e-573a809a49f8"
			id="9.1.2.5 Make"
			parent="9.1.2 Do">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to making something--joining things together to create something to be that did not exist before.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Make</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="10b6c417-d020-4318-a44a-ae69ea3eec5a"
			id="9.1.2.6 Change something"
			parent="9.1.2 Do">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to someone changing something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Change something</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="754ac437-2841-48c3-bbb0-7d6dff52605e"
			id="9.1.2.7 Event propositions"
			parent="9.1.2 Do">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate event propositions. Event propositions are similar in that they are normally expressed by a subject and a verb, possibly including an object, indirect object, or complement clause. However there are multiple ways in which a language can express an event, such as a passive construction, noun phrase, or subordinate clause. In addition each event type is different in its primary cases, and in the ways those cases are marked. Each event type has subtypes, such as intransitive, transitive, and ditransitive verbs. A great deal of research is needed in order to identify all the variations. Ultimately every verb must be investigated to determine how it behaves in each syntactic construction and how its case relations are marked. No two verbs are entirely alike.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Event propositions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.2.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0037693a-ae42-4e5c-85f5-10a05482d4ee"
			id="9.1.3 Thing"
			parent="9.1 General words">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words referring to things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Thing</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c9741b97-ad50-465c-a4ca-b21d488f45fe"
			id="9.1.3.1 Physical, non-physical"
			parent="9.1.3 Thing">
			<description>
				<form
					lang="en">
					<text>Use this domain for words describing something that is physical--that you can touch and see, and for words describing something that is non-physical--that you cannot touch or see.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Physical, non-physical</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="74cd7314-5ef6-4505-a35a-81468b5a3f3a"
			id="9.1.3.2 Situation"
			parent="9.1.3 Thing">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a situation--a particular time and place, and the things that are true about it.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Situation</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="316f27aa-ed6d-4bc3-9d14-840946a6f4e9"
			id="9.1.4 General adjectives"
			parent="9.1 General words">
			<description>
				<form
					lang="en">
					<text>Use this domain for general adjectives that can replace or stand for a specific adjective.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>General adjectives</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d9b9db39-d87e-4d04-8298-1f1b969dbda1"
			id="9.1.5 General adverbs"
			parent="9.1 General words">
			<description>
				<form
					lang="en">
					<text>Use this domain for general adverbs that can replace or stand for other adverbs.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>General adverbs</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="af0909a5-928a-4421-baaa-f33b14302714"
			id="9.2 Part of speech"
			parent="9 Grammar">
			<description>
				<form
					lang="en">
					<text>This domain is for organization purposes and should not be used for any words. Use the domains in this section for words that belong to a particular part of speech. It is best not to use these domains, since they are based on grammar and not meaning. But if you have a small group of words that belong to a part of speech and you want to list them all, you can use these domains. You can also classify words in this section if you don't know what they mean yet.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Part of speech</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="64f39297-426b-45a8-b5d2-097cf71d688c"
			id="9.2.1 Adjectives"
			parent="9.2 Part of speech">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all adjectives. If there are many adjectives in your language, you should not try to list them all here. If you want to find all the adjectives, most dictionary programs can sort your dictionary by part of speech. However if your language only has a few adjectives, you can list them all in this domain. In the book, "Where Have All the Adjectives Gone?" R. M. W. Dixon [Dixon, R. M. W. 1982. Where have all the adjectives gone? Berlin: Mouton.] identifies seven universal semantic types that are often expressed by adjectives. They are: Age (new, young, old), Dimension (big, little, long, short, wide, narrow, thick, fat, thin), Value (good, bad, proper, perfect, excellent, fine, delicious, atrocious, poor), Color (black, white, red), Human propensity (jealous, happy, kind, clever, generous, cruel, rude, proud, wicked), Physical property (hard, soft, heavy, light, rough, smooth, hot, cold, sweet, sour), Speed (fast, slow). Words in the Human propensity class may be nouns. Words in the Physical property and Speed classes may be verbs.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Adjectives</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="24d3d7f9-0fda-4759-930b-6b721d3e9115"
			id="9.2.2 Adverbs"
			parent="9.2 Part of speech">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all adverbs. If there are many adverbs in your language, it is probably not worth the trouble to list them here. The Shoebox program (and other dictionary programs) can sort your dictionary by part of speech.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Adverbs</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0296465a-25de-4af6-a122-376956b4b452"
			id="9.2.3 Pronouns"
			parent="9.2 Part of speech">
			<description>
				<form
					lang="en">
					<text>Use this domain for the personal pronouns, including independent, subject, object, and possessive pronouns. It is best to collect all the pronouns in a chart. This way you are more certain of collecting them all and seeing how they are related to each other. A language may have more sets and more distinctions than English does, or it may have less. For instance some languages have a pronoun 'we' which includes the hearer, and another pronoun 'we' which excludes the hearer. Other languages have an indefinite pronoun that means something like the English word 'someone'. Many languages do not have the masculine (he), feminine (she), and neuter (it) distinctions that English has. It is necessary to determine the sets and functions of the pronouns for each language.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Pronouns</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="13df6ee2-4189-4faa-b54d-768588d03978"
			id="9.2.3.1 Reflexive pronouns"
			parent="9.2.3 Pronouns">
			<description>
				<form
					lang="en">
					<text>Use this domain for pronouns that refer back to the subject of the sentence. These pronouns should be added to the chart of personal pronouns.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Reflexive pronouns</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d4521b0f-0703-48cc-94a0-f42ccc09959c"
			id="9.2.3.2 Indefinite pronouns"
			parent="9.2.3 Pronouns">
			<description>
				<form
					lang="en">
					<text>Use this domain for pronouns that do not refer to a definite person or thing, but can refer to anyone or anything. Some languages will not have all the sets of pronouns described below. Add each set you find in your language to the pronoun chart.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Indefinite pronouns</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8db17eef-6c42-4ba0-9f07-a3b0e7c8f1e1"
			id="9.2.3.3 Relative pronouns"
			parent="9.2.3 Pronouns">
			<description>
				<form
					lang="en">
					<text>Use this domain for pronouns used in relative clauses.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Relative pronouns</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="76795fdd-55dc-4fb7-a9ad-d1423c31df50"
			id="9.2.3.4 Question words"
			parent="9.2.3 Pronouns">
			<description>
				<form
					lang="en">
					<text>Use this domain for pronouns used in questions.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Question words</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.3.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ad4d28f0-5cbb-4b82-b736-9b41860a248c"
			id="9.2.3.5 Demonstrative pronouns"
			parent="9.2.3 Pronouns">
			<description>
				<form
					lang="en">
					<text>Use this domain for demonstrative pronouns.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Demonstrative pronouns</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.3.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a139558a-8df9-4fc9-bd3e-816a1408ba7f"
			id="9.2.3.6 Personally"
			parent="9.2.3 Pronouns">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate that someone does something himself, rather than through someone else.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Personally</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.3.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="811a2abc-4bf3-44e4-9ff4-e33ff4470ce6"
			id="9.2.4 Prepositions, postpositions"
			parent="9.2 Part of speech">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all prepositions and postpositions.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Prepositions, postpositions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f950b7cc-fb85-4dbb-b8ca-934d38cae7fc"
			id="9.2.5 Conjunctions"
			parent="9.2 Part of speech">
			<description>
