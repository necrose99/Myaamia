			guid="1148684a-0f44-4b5a-9e3e-3823163cd4a1"
			id="3.5.1.2.1 Announce"
			parent="3.5.1.2 Talk about a subject">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to announcing something--communicating something to many people.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Announce</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
