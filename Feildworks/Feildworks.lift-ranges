	<range
		id="lexical-relation">
		<range-element
			guid="b7862f14-ea5e-11de-8d47-0013722f8dec"
			id="Antonym">
			<description>
				<form
					lang="en">
					<text>Use this type for antonym relationships (e.g., fast, slow).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Antonym</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>ant</text>
				</form>
			</abbrev>
			<trait
				name="referenceType"
				value="1" />
		</range-element>
		<range-element
			guid="b7921ac2-ea5e-11de-880d-0013722f8dec"
			id="Calendar">
			<description>
				<form
					lang="en">
					<text>Use this type for calendar relationships (e.g., days of week, months in year).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Calendar</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>cal</text>
				</form>
			</abbrev>
			<trait
				name="referenceType"
				value="4" />
		</range-element>
		<range-element
			guid="b7a78fd8-ea5e-11de-9ef2-0013722f8dec"
			id="Classified Noun">
			<description>
				<form
					lang="en">
					<text>Use this relation for linking classifiers to the words that they classify.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Classified Noun</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>clf. for</text>
				</form>
			</abbrev>
			<field
				type="reverse-label">
				<form
					lang="en">
					<text>Classifier</text>
				</form>
			</field>
			<field
				type="reverse-abbrev">
				<form
					lang="en">
					<text>clf</text>
				</form>
			</field>
			<trait
				name="referenceType"
				value="3" />
		</range-element>
		<range-element
			guid="b79ba420-ea5e-11de-8f71-0013722f8dec"
			id="Compare">
			<description>
				<form
					lang="en">
					<text>Use this type for relationships that cannot be classified by a specific label, or of which there are too few examples to warrant creating a custom lexical relation.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Compare</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>cf</text>
				</form>
			</abbrev>
			<trait
				name="referenceType"
				value="5" />
		</range-element>
		<range-element
			guid="b764ce50-ea5e-11de-864f-0013722f8dec"
			id="Part">
			<description>
				<form
					lang="en">
					<text>A part/whole relation establishes a link between the sense for the whole (e.g., room), and senses for the parts (e.g., ceiling, wall, floor).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Part</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>pt</text>
				</form>
			</abbrev>
			<field
				type="reverse-label">
				<form
					lang="en">
					<text>Whole</text>
				</form>
			</field>
			<field
				type="reverse-abbrev">
				<form
					lang="en">
					<text>wh</text>
				</form>
			</field>
			<trait
				name="referenceType"
				value="3" />
		</range-element>
		<range-element
			guid="b770ba08-ea5e-11de-9ca9-0013722f8dec"
			id="Specific">
			<description>
				<form
					lang="en">
					<text>A generic/specific relation establishes a link between the sense for the generic (e.g., bird), and senses for the specifics (e.g., robin, cardinal, dove).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Specific</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>spec</text>
				</form>
			</abbrev>
			<field
				type="reverse-label">
				<form
					lang="en">
					<text>Generic</text>
				</form>
			</field>
			<field
				type="reverse-abbrev">
				<form
					lang="en">
					<text>gen</text>
				</form>
			</field>
			<trait
				name="referenceType"
				value="3" />
		</range-element>
		<range-element
			guid="b77a435c-ea5e-11de-9a66-0013722f8dec"
			id="Synonyms">
			<description>
				<form
					lang="en">
					<text>Use this type for synonym relationships (e.g., fast, fleet, hasty).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Synonyms</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>syn</text>
				</form>
			</abbrev>
			<trait
				name="referenceType"
				value="" />
		</range-element>
	</range>
	<range
		id="morph-type">
		<range-element
			guid="d7f713e4-e8cf-11d3-9764-00c04f186933"
			id="bound root">
			<description>
				<form
					lang="en">
					<text>A bound root is a root which cannot occur as a separate word apart from any other morpheme.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>bound root</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>bd root</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="*" />
		</range-element>
		<range-element
			guid="d7f713e7-e8cf-11d3-9764-00c04f186933"
			id="bound stem">
			<description>
				<form
					lang="en">
					<text>A bound stem is a stem which cannot occur as a separate word apart from any other morpheme.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>bound stem</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>bd stem</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="*" />
		</range-element>
		<range-element
			guid="d7f713df-e8cf-11d3-9764-00c04f186933"
			id="circumfix">
			<description>
				<form
					lang="en">
					<text>A circumfix is an affix made up of two separate parts which surround and attach to a root or stem.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>circumfix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>cfx</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c2d140e5-7ca9-41f4-a69a-22fc7049dd2c"
			id="clitic">
			<description>
				<form
					lang="en">
					<text>A clitic is a morpheme that has syntactic characteristics of a word, but shows evidence of being phonologically bound to another word. Orthographically, it stands alone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>clitic</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>clit</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0cc8c35a-cee9-434d-be58-5d29130fba5b"
			id="discontiguous phrase">
			<description>
				<form
					lang="en">
					<text>A discontiguous phrase has discontiguous constituents which (a) are separated from each other by one or more intervening constituents, and (b) are considered either (i) syntactically contiguous and unitary, or (ii) realizing the same, single meaning. An example is French ne...pas.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>discontiguous phrase</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>dis phr</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d7f713e1-e8cf-11d3-9764-00c04f186933"
			id="enclitic">
			<description>
				<form
					lang="en">
					<text>An enclitic is a clitic that is phonologically joined at the end of a preceding word to form a single unit. Orthographically, it may attach to the preceding word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>enclitic</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>enclit</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="=" />
		</range-element>
		<range-element
			guid="d7f713da-e8cf-11d3-9764-00c04f186933"
			id="infix">
			<description>
				<form
					lang="en">
					<text>An infix is an affix that is inserted within a root or stem.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>infix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>ifx</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="-" />
			<trait
				name="trailing-symbol"
				value="-" />
		</range-element>
		<range-element
			guid="18d9b1c3-b5b6-4c07-b92c-2fe1d2281bd4"
			id="infixing interfix">
			<description>
				<form
					lang="en">
					<text>An infixing interfix is an infix that can occur between two roots or stems.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>infixing interfix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>ifxnfx</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="-" />
			<trait
				name="trailing-symbol"
				value="-" />
		</range-element>
		<range-element
			guid="56db04bf-3d58-44cc-b292-4c8aa68538f4"
			id="particle">
			<description>
				<form
					lang="en">
					<text>A particle is a word that does not belong to one of the main classes of words, is invariable in form, and typically has grammatical or pragmatic meaning.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>particle</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>part</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a23b6faa-1052-4f4d-984b-4b338bdaf95f"
			id="phrase">
			<description>
				<form
					lang="en">
					<text>A phrase is a syntactic structure that consists of more than one word but lacks the subject-predicate organization of a clause.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>phrase</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>phr</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d7f713db-e8cf-11d3-9764-00c04f186933"
			id="prefix">
			<description>
				<form
					lang="en">
					<text>A prefix is an affix that is joined before a root or stem.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>prefix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>pfx</text>
				</form>
			</abbrev>
			<trait
				name="trailing-symbol"
				value="-" />
		</range-element>
		<range-element
			guid="af6537b0-7175-4387-ba6a-36547d37fb13"
			id="prefixing interfix">
			<description>
				<form
					lang="en">
					<text>A prefixing interfix is a prefix that can occur between two roots or stems.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>prefixing interfix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>pfxnfx</text>
				</form>
			</abbrev>
			<trait
				name="trailing-symbol"
				value="-" />
		</range-element>
		<range-element
			guid="d7f713e2-e8cf-11d3-9764-00c04f186933"
			id="proclitic">
			<description>
				<form
					lang="en">
					<text>A proclitic is a clitic that precedes the word to which it is phonologically joined. Orthographically, it may attach to the following word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>proclitic</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>proclit</text>
				</form>
			</abbrev>
			<trait
				name="trailing-symbol"
				value="=" />
		</range-element>
		<range-element
			guid="d7f713e5-e8cf-11d3-9764-00c04f186933"
			id="root">
			<description>
				<form
					lang="en">
					<text>A root is the portion of a word that (i) is common to a set of derived or inflected forms, if any, when all affixes are removed, (ii) is not further analyzable into meaningful elements, being morphologically simple, and, (iii) carries the principal portion of meaning of the words in which it functions.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>root</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>ubd root</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d7f713dc-e8cf-11d3-9764-00c04f186933"
			id="simulfix">
			<description>
				<form
					lang="en">
					<text>A simulfix is a change or replacement of vowels or consonants (usually vowels) which changes the meaning of a word. (Note: the parser does not currently handle simulfixes.)</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>simulfix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>smfx</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="=" />
			<trait
				name="trailing-symbol"
				value="=" />
		</range-element>
		<range-element
			guid="d7f713e8-e8cf-11d3-9764-00c04f186933"
			id="stem">
			<description>
				<form
					lang="en">
					<text>"A stem is the root or roots of a word, together with any derivational affixes, to which inflectional affixes are added." (LinguaLinks Library). A stem "may consist solely of a single root morpheme (i.e. a 'simple' stem as in <span
							class="Emphasized Text">man</span>), or of two root morphemes (e.g. a 'compound' stem, as in <span
							class="Emphasized Text">blackbird</span>), or of a root morpheme plus a derivational affix (i.e. a 'complex' stem, as in <span
							class="Emphasized Text">manly</span>, <span
							class="Emphasized Text">unmanly</span>, <span
							class="Emphasized Text">manliness</span>). All have in common the notion that it is to the stem that inflectional affixes are attached." (Crystal, 1997:362)</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>stem</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>ubd stem</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d7f713dd-e8cf-11d3-9764-00c04f186933"
			id="suffix">
			<description>
				<form
					lang="en">
					<text>A suffix is an affix that is attached to the end of a root or stem.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>suffix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>sfx</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="-" />
		</range-element>
		<range-element
			guid="3433683d-08a9-4bae-ae53-2a7798f64068"
			id="suffixing interfix">
			<description>
				<form
					lang="en">
					<text>A suffixing interfix is a suffix that can occur between two roots or stems.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>suffixing interfix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>sfxnfx</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="-" />
		</range-element>
		<range-element
			guid="d7f713de-e8cf-11d3-9764-00c04f186933"
			id="suprafix">
			<description>
				<form
					lang="en">
					<text>A suprafix is a kind of affix in which a suprasegmental is superimposed on one or more syllables of the root or stem, signalling a particular morphosyntactic operation. (Note: the parser does not currently handle suprafixes.)</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>suprafix</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>spfx</text>
				</form>
			</abbrev>
			<trait
				name="leading-symbol"
				value="~" />
			<trait
				name="trailing-symbol"
				value="~" />
		</range-element>
	</range>
	<range
		id="note-type">
		<range-element
			id="anthropology">
			<description>
				<form
					lang="en">
					<text>Gives anthropological information.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>anthropology</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="biblography">
			<description>
				<form
					lang="en">
					<text>Biblographic information.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>biblography</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="comment">
			<description>
				<form
					lang="en">
					<text>This note is an arbitrary comment not for publication</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>comment</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="discourse">
			<description>
				<form
					lang="en">
					<text>Gives discourse information about a sense.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>discourse</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="encyclopedic">
			<description>
				<form
					lang="en">
					<text>This note gives encyclopedic information.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>encyclopedic</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="exemplar">
			<description>
				<form
					lang="en">
					<text>Gives the exemplar form of a sense</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>exemplar</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="general">
			<description>
				<form
					lang="en">
					<text>General notes that do not fall in another clear category</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>general</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="grammar">
			<description>
				<form
					lang="en">
					<text>Gives grammatical information about a word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>grammar</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="literal-meaning">
			<description>
				<form
					lang="en">
					<text>Gives the literal meaning of a word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>literal-meaning</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="phonology">
			<description>
				<form
					lang="en">
					<text>Gives phonological information about a word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>phonology</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="questions">
			<description>
				<form
					lang="en">
					<text>Contains questions yet to be answered</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>questions</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="restrictions">
			<description>
				<form
					lang="en">
					<text>Gives information on the restriction of usage of a word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>restrictions</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="scientific-name">
			<description>
				<form
					lang="en">
					<text>Gives the scientific name of a sense</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>scientific name</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="semantics">
			<description>
				<form
					lang="en">
					<text>Gives semantic information about a sense.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>semantics</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="sociolinguistics">
			<description>
				<form
					lang="en">
					<text>Gives sociolinguistic information about a sense.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>sociolinguistics</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="source">
			<description>
				<form
					lang="en">
					<text>Contains information on sources</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>source</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="summary-definition">
			<description>
				<form
					lang="en">
					<text>Gives a summary definition of a word.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>summary-definition</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="usage">
			<description>
				<form
					lang="en">
					<text>Gives information on usage</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>usage</text>
				</form>
			</label>
		</range-element>
	</range>
	<range
		id="paradigm">
		<range-element
			id="1d">
			<description>
				<form
					lang="en">
					<text>1st dual</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>1d</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="1e">
			<description>
				<form
					lang="en">
					<text>1st exclusive</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>1e</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="1i">
			<description>
				<form
					lang="en">
					<text>1st inclusive</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>1i</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="1p">
			<description>
				<form
					lang="en">
					<text>1st person plural</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>1p</text>
				</form>
			</label>
		</range-element>
		<range-element
			id="1s">
			<description>
				<form
					lang="en">
					<text>1st person singular</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>1s</text>
				</form>
			</label>
