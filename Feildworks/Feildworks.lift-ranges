			id="8.1.1 Number"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to numbers. Every language has a word for 'one', and a word for 'two'. These two numbers often have special words. So we have included a separate domain for 'one' and 'two'. In addition the numbers form a series (one, two, three...). Most languages have more than one series of numbers (first, second, third...). So we have also included a domain for each series of numbers that most languages have. Your language may have other series of numbers. Put them in the domain 'Number series'.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Number</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b6686c7c-39de-40b5-adee-67fc7dc54374"
			id="8.1.1.1 Cardinal numbers"
			parent="8.1.1 Number">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the cardinal numbers (one, two, three)--the numbers used to count.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Cardinal numbers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2c04fa05-eebf-4331-b392-23f795c32382"
			id="8.1.1.1.1 One"
			parent="8.1.1.1 Cardinal numbers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the number one. It appears that every language has a word for 'one' and 'two', but not every language has a word for the numbers higher than two. Many languages have several words that mean 'one'.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>One</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d086c2ad-2d11-4250-a25a-dc6538439db6"
			id="8.1.1.1.2 Two"
			parent="8.1.1.1 Cardinal numbers">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the number two.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Two</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="816490a4-2cac-472a-bbb0-eafbb9bbe4a8"
			id="8.1.1.2 Ordinal numbers"
			parent="8.1.1 Number">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the ordinal numbers (first, second, third)--the numbers used to indicate the order of something in a series, such as "the first child".</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Ordinal numbers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d85d0838-a9e4-4787-8fce-7d0466bc24b9"
			id="8.1.1.3 Number of times"
			parent="8.1.1 Number">
			<description>
				<form
					lang="en">
					<text>Use this domain for numbers that refer to the number of times something happens or is done. These numbers may be adverbs as in English (twice) or in some languages they may be verbs (to do something two times).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Number of times</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a57185c3-0cb5-41fa-94bf-da0c9edac600"
			id="8.1.1.4 Multiples"
			parent="8.1.1 Number">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to multiples of something (single, double, triple).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Multiples</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ffa13b7d-5eaa-43be-8518-51d9aa08f321"
			id="8.1.1.5 Numbered group"
			parent="8.1.1 Number">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to a group of a particular number of things or people (solo, duo, trio; alone, in threes).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Numbered group</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="64e6c0db-6dd6-4b80-bbe9-c96bb161674b"
			id="8.1.1.6 Fraction"
			parent="8.1.1 Number">
			<description>
				<form
					lang="en">
					<text>Use this domain for the numbers that refer to a fraction of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Fraction</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0e250e72-6c3f-424f-9e62-2dcc9729d817"
			id="8.1.1.7 Number series"
			parent="8.1.1 Number">
			<description>
				<form
					lang="en">
					<text>Use this domain for other series of numbers that are different from those in the previous domains.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Number series</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="c0d903bf-6502-45dd-9dd8-cff7f022c696"
			id="8.1.2 Count"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to counting--to say the numbers in order, or to use numbers to find an amount.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Count</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8bdf4847-903b-4af6-9553-3cfab65de516"
			id="8.1.2.1 Mathematics"
			parent="8.1.2 Count">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to mathematics and arithmetic--the study of numbers.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mathematics</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="83899b19-8b39-4bf0-b124-4c6188569ec8"
			id="8.1.2.2 Add numbers"
			parent="8.1.2 Count">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to adding two numbers together.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Add numbers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7cf6312e-f9f0-49e8-ae60-7677fac86c3f"
			id="8.1.2.3 Subtract numbers"
			parent="8.1.2 Count">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to subtracting one number from another.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Subtract numbers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="57f07b5f-75bf-4565-b969-ce0adc0b50d4"
			id="8.1.2.4 Multiply numbers"
			parent="8.1.2 Count">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to multiplying one number times another.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Multiply numbers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7b17e304-9a3f-463f-8216-cd1e1e119e0e"
			id="8.1.2.5 Divide numbers"
			parent="8.1.2 Count">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to dividing one number by another number.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Divide numbers</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0ebf9fcc-ee38-4f5f-ab5e-c76e199ef7ae"
			id="8.1.3 Plural"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words and affixes that indicate that there is more than one of something. Some languages, such as Indo-European languages, indicate plural with an affix. Other languages, such as Austronesian languages, use a separate word. Some languages also have words or affixes that indicate that there are two of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Plural</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1b6b0c12-9ecd-45cb-bb0e-0dadb435eddf"
			id="8.1.3.1 Many, much"
			parent="8.1.3 Plural">
			<description>
				<form
					lang="en">
					<text>Use this domain for words indicating that there are many things or people, or that there is much of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Many, much</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="36934fab-c0ed-4f25-a387-e1cca26b2401"
			id="8.1.3.2 Few, little"
			parent="8.1.3 Plural">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related there being few or little of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Few, little</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d8ea1902-5fa6-4fda-b7b2-1f9c301cdc5f"
			id="8.1.3.3 Group of things"
			parent="8.1.3 Plural">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that refer to a group of things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Group of things</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8216627d-9d20-4a5c-8bfd-0709c16e7a08"
			id="8.1.4 More"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to there being more of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>More</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="fcc204a3-eae4-46d1-a9dc-08864fde1772"
			id="8.1.4.1 Less"
			parent="8.1.4 More">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate that the number or amount of something is less than the number or amount of another thing.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Less</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f2022802-4f43-4fa2-8c58-33a8b9e75895"
			id="8.1.4.2 Increase"
			parent="8.1.4 More">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to something increasing in number or amount--to be more than before.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Increase</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1ff743cb-49e0-483d-8a1d-4603a7d6c395"
			id="8.1.4.3 Decrease"
			parent="8.1.4 More">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to something decreasing in number or amount--to be less than before.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Decrease</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f7960e84-5af9-4999-9028-783058aa8c5c"
			id="8.1.5 All"
			parent="8.1 Quantity">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to all.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>All</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cbcff912-e1c2-4d9b-9938-85d73e7e7265"
			id="8.1.5.1 Some"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to some--a number or amount of things or people when the number is not stated; an indefinite number or amount.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Some</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="bfbfb9b5-363d-4767-a5cb-1b11b348efd6"
			id="8.1.5.2 None, nothing"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that nothing, no one, never, and nowhere.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>None, nothing</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="bbb21324-089d-4368-a2ac-37c6bbfcbffc"
			id="8.1.5.3 Both"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to both of two things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Both</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="d1687857-0f1d-4098-affb-b283a6677b6b"
			id="8.1.5.4 Most, almost all"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to most--more than half and less than all of something.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Most, almost all</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="0aaacffe-9b6c-49a7-bf68-c0f9ff3e120e"
			id="8.1.5.5 Most, least"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the most--the largest number or amount; or the least--the smallest number or amount. Most/least may refer to the largest/smallest number possible or needed. If there are several groups being counted, most/least may refer to the largest/smallest group.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Most, least</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="afdd8b8e-9502-4d06-94ee-e79815b65750"
			id="8.1.5.6 Almost"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to a number or amount that is almost the same as another number.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Almost</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e94a5cf3-1fd4-4b52-902f-bbf0ad6bac2b"
			id="8.1.5.7 Only"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to only a particular number or amount of people or things--no more than one, or no more than a particular number or amount.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Only</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8f4c9266-a025-4b7a-bd67-fe0c043bf6f5"
			id="8.1.5.8 Exact"
			parent="8.1.5 All">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that indicate whether a number or amount is exact--not more and not less.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Exact</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.5.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
