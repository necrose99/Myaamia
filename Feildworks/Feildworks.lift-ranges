		</range-element>
		<range-element
			guid="6712385a-6740-4f28-8bbe-8615ea17116b"
			id="8.4.5.1.5 Regular"
			parent="8.4.5.1 Order, sequence">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to something that happens regularly.</text>
