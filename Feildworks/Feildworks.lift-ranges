			guid="ca9c215a-e568-4d09-b3a9-b5727cd831d6"
			id="2.6.6.5 Bury"
			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to disposing of a dead body. Different cultures have practices other than burying a body in the ground. Include words for all practices used by the culture.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Bury</text>
				</form>
			</label>
