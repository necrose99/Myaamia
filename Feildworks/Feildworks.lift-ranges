			guid="2933a9c1-aa62-46fb-a03c-68aed7fae9b7"
			id="5.5.4 Burn"
			parent="5.5 Fire">
			<description>
				<form
					lang="en">
					<text>Use this domain for verbs that are used of fire: "The fire is ____." In some languages there are verbs for what is happening to the thing that is burning: "The house is ____."</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Burn</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>5.5.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b93bdfa4-486c-44a0-8266-557ccdc78b31"
			id="5.5.5 What fires produce"
			parent="5.5 Fire">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the things that fires produce.</text>
