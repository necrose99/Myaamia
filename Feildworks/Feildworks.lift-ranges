			</description>
			<label>
				<form
					lang="en">
					<text>Conjunctions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>9.2.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a42aa891-e4fd-489e-b573-b9d20dfc5c2a"
			id="9.2.5.1 Phrase conjunctions"
			parent="9.2.5 Conjunctions">
			<description>
				<form
					lang="en">
					<text>Use this domain to list all phrase level conjunctions--conjunctions that join two words within a phrase.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Phrase conjunctions</text>
				</form>
			</label>
