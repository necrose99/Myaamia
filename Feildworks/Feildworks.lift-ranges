		<range-element
			guid="a4fc78d6-7591-4fb3-8edd-82f10ae3739d"
			id="Pro-form">
			<description>
				<form
					lang="en">
					<text>A pro-form is a part of speech whose members usually substitute for other constituents, including phrases, clauses, or sentences, and whose meaning is recoverable from the linguistic or extralinguistic context.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Pro-form</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>pro-form</text>
				</form>
			</abbrev>
			<trait
				name="catalog-source-id"
				value="Pro-form" />
		</range-element>
		<range-element
			guid="a3274cfd-225f-45fd-8851-a7b1a1e1037a"
			id="Pronoun"
			parent="Pro-form">
			<description>
				<form
					lang="en">
					<text>A pronoun is a pro-form which functions like a noun and substitutes for a noun or noun phrase.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Pronoun</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>pro</text>
