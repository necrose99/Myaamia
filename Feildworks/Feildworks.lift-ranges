				<form
					lang="en">
					<text>8.1.7.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="60b8dcfd-49a0-4ab4-82a7-2c5058b325ae"
			id="8.1.7.4 Remain, remainder"
			parent="8.1.7 Enough">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to the remainder of something--the part or amount of something that remains behind after the other parts have been taken away. Something can be left because everything else has been used or eaten, or everything else has been destroyed or burned.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Remain, remainder</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>8.1.7.4</text>
				</form>
			</abbrev>
		</range-element>
