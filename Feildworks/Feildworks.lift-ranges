		<range-element
			guid="3014de03-88e5-4330-9682-51963a41ca50"
			id="1.6.1.6 Shark, ray"
			parent="1.6.1 Types of animals">
			<description>
				<form
					lang="en">
					<text>Use this domain for sharks and rays--animals with cartilage instead of bones (phylum Chordata, class Chondrichthyes), and eels (phylum Chordata, class Cyclostomata).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Shark, ray</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.1.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ecc39bc2-6336-48ca-be46-cf5e49a3c267"
			id="1.6.1.7 Insect"
			parent="1.6.1 Types of animals">
			<description>
				<form
					lang="en">
					<text>Use this domain for the names of insect species (phylum Arthropoda, class Insecta). Note that insects have six legs and spiders have eight legs. However some languages may not distinguish insects from spiders and may use other characteristics to sub-divide the Arthropods.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Insect</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cfb159f7-82f6-4789-b9b4-8f611820f350"
			id="1.6.1.8 Spider"
			parent="1.6.1 Types of animals">
			<description>
				<form
					lang="en">
					<text>Use this domain for spiders (phylum Arthropoda, class Arachnida). Note that insects have six legs and spiders have eight legs. However some languages may not distinguish insects from spiders and may use other characteristics to sub-divide the Arthropods.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Spider</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.1.8</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="38473463-4b92-4681-8fd0-0aca0342e88a"
			id="1.6.1.9 Small animals"
			parent="1.6.1 Types of animals">
			<description>
				<form
					lang="en">
					<text>Use this domain for the names of worms, animals with shells, and other animals that do not fit into any of the other categories.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Small animals</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.1.9</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ffd0547e-e537-4614-ac3f-6d8cd3351f33"
			id="1.6.2 Parts of an animal"
			parent="1.6 Animal">
			<description>
