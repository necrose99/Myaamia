			guid="08d5e632-0aed-4924-b3bb-d43de3420385"
			id="2.6.6.3 Funeral"
			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to a funeral and other things that are done after a person dies.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Funeral</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.6.6.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f2d0f288-5bbe-4fa0-9e8f-ddcc74891701"
			id="2.6.6.4 Mourn"
			parent="2.6.6 Die">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to mourning a death--to feel bad because someone died and to show this feeling in various ways. Include whatever cultural practices are used.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mourn</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.6.6.4</text>
				</form>
			</abbrev>
		</range-element>
