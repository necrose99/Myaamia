			parent="3.5.1.1 Voice">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to shouting--to speak loudly.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Shout</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9612bdd6-15cb-4269-aaf9-481c7b35b5dd"
			id="3.5.1.1.2 Speak quietly"
			parent="3.5.1.1 Voice">
			<description>
				<form
					lang="en">
					<text>Use this domain for words that describe a person speaking quietly.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Speak quietly</text>
				</form>
			</label>
