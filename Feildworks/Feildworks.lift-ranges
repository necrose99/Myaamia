		<range-element
			guid="f4491f9b-3c5e-42ab-afc0-f22e19d0fff5"
			id="3 Language and thought">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words referring to mental and verbal activity. This domain is primarily for grouping many related domains. Therefore there may be no general word in a language to cover such a broad area of meaning.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Language and thought</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1cb79293-d4f7-4990-9f50-3bb595744f61"
			id="3.1 Soul, spirit"
			parent="3 Language and thought">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words related to the immaterial, non-physical part of a person, as opposed to the body.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Soul, spirit</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.1</text>
				</form>
			</abbrev>
		</range-element>
