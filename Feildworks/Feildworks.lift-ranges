			parent="3.5.1.1 Voice">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to speaking a lot.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Speak a lot</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.5.1.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="78b0ad1b-0766-41ba-b788-d176addd5e9f"
