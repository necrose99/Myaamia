		<range-element
			guid="30e6b42c-6bbf-4659-99e7-aa4b8e68c9ce"
			id="4.3.1 Good, moral"
			parent="4.3 Behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being good or moral in behavior.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Good, moral</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="744d1402-05f5-4491-9c15-a5af03595edb"
			id="4.3.1.1 Bad, immoral"
			parent="4.3.1 Good, moral">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being bad or immoral in behavior, and for words describing a bad person.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Bad, immoral</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a6797fd1-e368-422b-9710-96e0af39552d"
			id="4.3.1.2 Meet a standard"
			parent="4.3.1 Good, moral">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to meeting a standard.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Meet a standard</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1461c106-d9e0-417d-9487-a57e6d0cced0"
			id="4.3.1.2.1 Below standard"
			parent="4.3.1.2 Meet a standard">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to behaving below a standard.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Below standard</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="4260e110-7b04-4d40-9391-486a57aa3031"
			id="4.3.1.3 Mature in behavior"
			parent="4.3.1 Good, moral">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to acting maturely--to act like an adult rather than a child.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Mature in behavior</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="2b846476-00cf-4d82-97a1-26e1eda880ca"
			id="4.3.1.3.1 Immature in behavior"
			parent="4.3.1.3 Mature in behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to behaving in an immature way--for either a child or an adult to act like a child.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Immature in behavior</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="de1ffd73-af3b-47a2-8e98-ac1659a84cac"
			id="4.3.1.3.2 Sensible"
			parent="4.3.1.3 Mature in behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being sensible--to think about what you do.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Sensible</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cb783ad9-4650-416e-bf63-88c4ca43fe6a"
			id="4.3.1.4 Reputation"
			parent="4.3.1 Good, moral">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to having a good reputation--when most people think well of someone because he does good things and doesn't do bad things.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Reputation</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="afc25fbb-9060-4af2-8225-3fddbab2227d"
			id="4.3.1.5 Patient"
			parent="4.3.1 Good, moral">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being patient--if you are patient, you don't get angry or do anything bad even though something bad happens to you for a long time.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Patient</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8d490e91-6383-45ea-a3d7-b9c950822f98"
			id="4.3.1.5.1 Impatient"
			parent="4.3.1.5 Patient">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being impatient--if you are impatient, you get angry or do something bad when something bad happens to you for a long time.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Impatient</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.5.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="93489181-ad8c-4a18-8dbc-fd7a9c871126"
			id="4.3.1.5.2 Bad-tempered"
			parent="4.3.1.5 Patient">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being bad-tempered--to behave in an angry, unfriendly way.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Bad-tempered</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.1.5.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="9b0fef63-5935-447d-801a-bb02dd6212bb"
			id="4.3.2 Admire someone"
			parent="4.3 Behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to admiring someone--to feel good about someone because you think that he is a good person.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Admire someone</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="a2a3e21a-819c-4400-b2e6-e6c1a0a0ded3"
			id="4.3.2.1 Despise someone"
			parent="4.3.2 Admire someone">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to despising someone--to feel bad about someone because you think they are not as good as you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Despise someone</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.2.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="5d21b3f1-85d5-4999-af64-c4d0101050c0"
			id="4.3.2.2 Humble"
			parent="4.3.2 Admire someone">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to being humble--to not think that you are better than other people, or to not think that you are better than you really are, and to not talk or act as if you were better than other people.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Humble</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.2.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="18b3ca02-18fe-4ab5-8709-c20957a0a2fb"
			id="4.3.2.3 Proud"
			parent="4.3.2 Admire someone">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to being proud--to think that something or someone is very good and to feel very good about them, especially to think and feel very good about yourself--to think that you are better than others, to think that you are better than you really are, or to talk and act as if you were better than other people.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Proud</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.2.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="054e81ce-abd8-4069-989d-13e2fa58851c"
			id="4.3.2.4 Show off"
			parent="4.3.2 Admire someone">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to showing off--to behave in a way that attracts people's attention because you want them to admire you.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Show off</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.2.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="e7caa24f-155d-47cd-946d-cc0d06dfc764"
			id="4.3.3 Love"
			parent="4.3 Behavior">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to loving someone--to feel good about someone, want good things to happen to them, and want to do good things for them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Love</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="642ff468-e6c8-4fd0-8f52-262efa8f7774"
			id="4.3.3.1 Hate, ill will"
			parent="4.3.3 Love">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to hating someone--to want something bad to happen to someone, or to want to do something bad to someone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Hate, ill will</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.3.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="b553e989-2b2a-4b1e-a987-ae75f3862501"
			id="4.3.3.2 Not care"
			parent="4.3.3 Love">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to not caring about someone.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Not care</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>4.3.3.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="611aa361-4ddd-450b-a152-94984a274575"
			id="4.3.3.3 Abandon"
			parent="4.3.3 Love">
			<description>
				<form
					lang="en">
					<text>Use this domain for words related to abandoning someone or something--to leave and not return to them.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
