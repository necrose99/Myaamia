		<range-element
			guid="e76227e8-4a04-4fbd-a16e-5baa3d9e97a9"
			id="1.6.4 Animal actions"
			parent="1.6 Animal">
			<description>
				<form
					lang="en">
					<text>Use this domain for actions of animals.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Animal actions</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.4</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="284433df-7b37-4e63-a614-78520c483213"
			id="1.6.4.1 Animal movement"
			parent="1.6.4 Animal actions">
			<description>
				<form
					lang="en">
					<text>Use this domain for ways in which animals move. Only include words specific for the movement of animals. For the movement of people use the domains under Movement. It is necessary to think through how each type of animal moves, especially the important ones.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Animal movement</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.4.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="8f68d85f-70f8-4662-9b4b-1dd2900a002a"
			id="1.6.4.2 Animal eating"
			parent="1.6.4 Animal actions">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to animals eating. Because animals often eat in very different ways from people, many languages will have words that are specific to the way an animal eats.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Animal eating</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.4.2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="cb99a086-8c6d-4f90-81db-6afa69ae5455"
			id="1.6.4.3 Animal sounds"
			parent="1.6.4 Animal actions">
			<description>
				<form
					lang="en">
					<text>Use this domain for the sounds animals make. It is necessary to think through the sounds each type of animal makes, especially the important ones.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Animal sounds</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.4.3</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="17d5f429-6550-4a3a-a755-5ac3c3d7e04f"
			id="1.6.5 Animal home"
			parent="1.6 Animal">
			<description>
				<form
					lang="en">
					<text>Use this domain for animal homes. It is necessary to think through the homes of each type of animal, especially the important ones.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Animal home</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.5</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="85646774-8145-4553-b8a7-6927cd077908"
			id="1.6.6 Animal group"
			parent="1.6 Animal">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to groups of animals.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Animal group</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.6</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="7c64f65b-2889-4f90-ba61-6b5f7634d4bc"
			id="1.6.7 Male and female animals"
			parent="1.6 Animal">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to male and female animals. Most languages have special words for the male and female of a species only for domesticated animals. Sometimes there will be a word for the male and not the female, and vice versa (male dog, bitch). Sometimes the word for one is also used generically (cow for both female and generic).</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Male and female animals</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.6.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="aa57936d-f8a9-4603-8c3d-27abccd13531"
			id="1.7 Nature, environment"
			parent="1 Universe, creation">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to nature and the environment--the world around us. Include words that refer to how people damage or protect nature.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Nature, environment</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.7</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="f4ed1712-c072-4213-b89d-eb3a9be233b2"
			id="1.7.1 Natural"
			parent="1.7 Nature, environment">
			<description>
				<form
					lang="en">
					<text>Use this domain for words describing something that is natural--something in the world around us, as opposed to something that has been made or changed by people.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Natural</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>1.7.1</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="ba06de9e-63e1-43e6-ae94-77bea498379a"
			id="2 Person">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words for a person or all mankind.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Person</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2</text>
				</form>
			</abbrev>
		</range-element>
		<range-element
			guid="1b0270a5-babf-4151-99f5-279ba5a4b044"
			id="2.1 Body"
			parent="2 Person">
			<description>
				<form
					lang="en">
					<text>Use this domain for general words for the whole human body, and general words for any part of the body. Use a drawing or photo to label each part. Some words may be more general than others are and include some of the other words. For instance 'head' is more general than 'face' or 'nose'. Be sure that both general and specific parts are labeled.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Body</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>2.1</text>
				</form>
			</abbrev>
		</range-element>
