			parent="3.1.2 Mental state">
			<description>
				<form
					lang="en">
					<text>Use this domain for words referring to a mental state when the mind is working hard.</text>
				</form>
			</description>
			<label>
				<form
					lang="en">
					<text>Alert</text>
				</form>
			</label>
			<abbrev>
				<form
					lang="en">
					<text>3.1.2.1</text>
				</form>
			</abbrev>
		</range-element>
